<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qing_ai_agent_knowledge_form" model="ir.ui.view">
        <field name="name">qing.ai.agent.knowledge.form</field>
        <field name="model">qing.ai.agent</field>
        <field name="inherit_id" ref="qing_ai.view_qing_ai_agent_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='skill_ids']" position="after">
                <field name="knowledge_space_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
