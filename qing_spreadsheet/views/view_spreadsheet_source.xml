<odoo>
    <record id="view_qing_spreadsheet_source_list" model="ir.ui.view">
        <field name="name">qing.spreadsheet.source.list</field>
        <field name="model">qing.spreadsheet.source</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="model_id"/><field name="active"/></list></field>
    </record>
    <record id="view_qing_spreadsheet_source_form" model="ir.ui.view">
        <field name="name">qing.spreadsheet.source.form</field>
        <field name="model">qing.spreadsheet.source</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/><field name="model_id" options="{'no_create': True}"/><field name="active"/>
                <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <p class="text-muted">Enable only the fields needed for analysis. This policy does not grant access to business records.</p>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_sources" model="ir.actions.act_window">
        <field name="name">Data Sources</field><field name="res_model">qing.spreadsheet.source</field><field name="view_mode">list,form</field>
    </record>
</odoo>
