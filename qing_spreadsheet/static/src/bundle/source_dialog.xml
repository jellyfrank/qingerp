<templates xml:space="preserve">
    <t t-name="qing_spreadsheet.SourceDialog">
        <Dialog title="this.title" size="'lg'">
            <div t-if="this.state.error" class="alert alert-danger" role="alert" t-esc="this.state.error"/>
            <p t-if="!this.state.sources.length">No readable data sources are enabled. Ask a spreadsheet manager to configure them.</p>
            <div t-else="" class="d-grid gap-3">
                <label>Data source<select class="form-select" t-att-disabled="!!this.props.initial" t-on-change="(ev) => this.selectModel(ev.target.value)"><option t-foreach="this.state.sources" t-as="source" t-key="source.id" t-att-value="source.model" t-att-selected="source.model === this.state.model" t-esc="source.name"/></select></label>
                <label>Insert as<select class="form-select" t-att-disabled="!!this.props.initial" t-att-value="this.state.kind" t-on-change="(ev) => this.state.kind = ev.target.value"><option value="list">Record list</option><option value="pivot">Pivot table</option></select></label>
                <div t-if="this.state.kind === 'list'">
                    <div class="d-flex flex-wrap gap-3"><label t-foreach="this.source.fields" t-as="field" t-key="field.name"><input type="checkbox" class="form-check-input me-1" t-att-checked="this.state.fields.includes(field.name)" t-on-change="(ev) => this.toggleField(field.name, ev.target.checked)"/><t t-esc="field.string"/></label></div>
                    <label t-if="!this.props.initial" class="mt-3">Maximum rows<input class="form-control" type="number" min="1" max="5000" t-att-value="this.state.limit" t-on-input="(ev) => this.state.limit = ev.target.valueAsNumber"/></label>
                </div>
                <div t-else="" class="row">
                    <label class="col">Group by<select class="form-select" t-att-value="this.state.group" t-on-change="(ev) => this.state.group = ev.target.value"><option t-foreach="this.source.fields" t-as="field" t-key="field.name" t-att-value="field.name" t-esc="field.string"/></select></label>
                    <label class="col">Measure<select class="form-select" t-att-value="this.state.measure" t-on-change="(ev) => this.state.measure = ev.target.value"><option value="__count">Record count</option><option t-foreach="this.numericFields" t-as="field" t-key="field.name" t-att-value="field.name" t-esc="field.string"/></select></label>
                    <label class="col" t-if="this.state.measure !== '__count'">Aggregation<select class="form-select" t-att-value="this.state.aggregate" t-on-change="(ev) => this.state.aggregate = ev.target.value"><option value="sum">Sum</option><option value="avg">Average</option><option value="min">Minimum</option><option value="max">Maximum</option></select></label>
                </div>
                <div t-key="this.state.model"><label>Filters</label><DomainSelector resModel="this.state.model" domain="this.state.domain" readonly="false" update="(domain) => this.state.domain = domain"/></div>
                <p class="text-muted mb-0">Data is read with your current permissions in this workbook's company. Date groups use months. Lists contain at most 5,000 rows.</p>
            </div>
            <t t-set-slot="footer"><button class="btn btn-primary" t-on-click="this.insert" t-att-disabled="!this.source"><t t-if="this.props.initial">Update</t><t t-else="">Insert</t></button><button class="btn btn-secondary" t-on-click="this.props.close">Cancel</button></t>
        </Dialog>
    </t>
    <t t-name="qing_spreadsheet.SourcesDialog">
        <Dialog title="this.title" size="'md'">
            <p t-if="!this.props.sources.length">This workbook has no Odoo data sources yet.</p>
            <div t-foreach="this.props.sources" t-as="source" t-key="source.kind + source.id" class="d-flex gap-2 align-items-center border-bottom py-2">
                <span class="me-auto" t-esc="source.definition.name"/><span class="text-muted" t-esc="source.kind"/><button class="btn btn-secondary btn-sm" t-on-click="() => this.edit(source)">Edit</button>
            </div>
            <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="this.props.close">Close</button></t>
        </Dialog>
    </t>
</templates>
