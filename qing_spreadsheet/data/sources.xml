<odoo noupdate="1">
    <record id="source_contacts" model="qing.spreadsheet.source">
        <field name="name">Contacts</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="field_ids" eval="[Command.set([ref('base.field_res_partner__name'), ref('base.field_res_partner__city'), ref('base.field_res_partner__country_id'), ref('base.field_res_partner__is_company'), ref('base.field_res_partner__create_date'), ref('base.field_res_partner__active')])]"/>
    </record>
    <record id="source_products" model="qing.spreadsheet.source">
        <field name="name">Products</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="field_ids" eval="[Command.set([ref('product.field_product_product__name'), ref('product.field_product_product__default_code'), ref('product.field_product_product__list_price'), ref('product.field_product_product__categ_id'), ref('product.field_product_product__active')])]"/>
    </record>
</odoo>
