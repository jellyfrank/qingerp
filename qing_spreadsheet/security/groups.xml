<odoo>
    <record id="privilege_spreadsheet" model="res.groups.privilege">
        <field name="name">Spreadsheets</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_spreadsheet_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_spreadsheet"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_spreadsheet_manager'))]"/>
    </record>
</odoo>
