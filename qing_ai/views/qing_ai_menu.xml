<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_qing_ai_conversation" model="ir.actions.act_window">
        <field name="name">Daily Assistant</field>
        <field name="res_model">qing.ai.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a conversation with Qing AI.</p>
        </field>
    </record>
    <record id="action_qing_ai_daily_assistant" model="ir.actions.client">
        <field name="name">Daily Assistant</field>
        <field name="tag">qing_ai.daily_assistant</field>
    </record>
    <menuitem id="menu_qing_ai_root" name="Qing AI" sequence="32"
              web_icon="qing_ai,static/description/icon.png" groups="base.group_user"/>
    <menuitem id="menu_qing_ai_assistant" name="Daily Assistant" parent="menu_qing_ai_root"
              action="action_qing_ai_daily_assistant" sequence="10" groups="base.group_user"/>

    <record id="action_qing_ai_res_partner" model="ir.actions.server">
        <field name="name">Ask Qing AI</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = env['qing.ai.conversation'].action_open_for_record('res.partner', record.id)</field>
    </record>
    <record id="action_qing_ai_product_template" model="ir.actions.server">
        <field name="name">Ask Qing AI</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = env['qing.ai.conversation'].action_open_for_record('product.template', record.id)</field>
    </record>
</odoo>
