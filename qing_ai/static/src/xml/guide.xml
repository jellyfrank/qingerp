<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="qing_ai.Guide">
        <main class="o_action overflow-auto">
            <div class="container py-4">
                <h1 class="h3">
                    <t t-if="this.state.config?.professional">AI Implementation Advisor</t>
                    <t t-else="">AI Assistant · Public Manual</t>
                </h1>
                <div t-if="this.state.config">
                    <p class="text-muted">Choose a QingERP topic or question. Your selected model receives that choice and applicable published passages.</p>
                    <form t-on-submit.prevent="() => this.answer()" class="row g-3 align-items-end mb-3">
                        <div class="col-12 col-lg">
                            <label for="qing_ai_guide_filter" class="form-label">Find a topic</label>
                            <input id="qing_ai_guide_filter" type="search" class="form-control" maxlength="200"
                                   placeholder="Search manual topics" t-att-value="this.state.filter"
                                   t-on-input="(event) => this.filterTopics(event)" t-att-disabled="this.state.busy"/>
                        </div>
                        <div class="col-12 col-lg">
                            <label for="qing_ai_guide_topic" class="form-label">Topic</label>
                            <select id="qing_ai_guide_topic" class="form-select" t-att-value="this.state.topic"
                                    t-on-change="(event) => this.setTopic(event)" t-att-disabled="this.state.busy">
                                <option value="">Select a topic</option>
                                <option t-foreach="this.topics" t-as="topic" t-key="topic.topic" t-att-value="topic.topic" t-esc="topic.title"/>
                            </select>
                        </div>
                        <div t-if="this.questions.length" class="col-12 col-lg">
                            <label for="qing_ai_guide_question" class="form-label">Question</label>
                            <select id="qing_ai_guide_question" class="form-select" t-att-value="this.state.question"
                                    t-on-change="(event) => this.state.question = event.target.value" t-att-disabled="this.state.busy">
                                <option value="">Overview</option>
                                <option t-foreach="this.questions" t-as="question" t-key="question.id"
                                        t-att-value="question.id" t-esc="question.text"/>
                            </select>
                        </div>
                        <div class="col-12 col-lg-auto">
                            <label for="qing_ai_guide_provider" class="form-label">AI provider</label>
                            <select id="qing_ai_guide_provider" class="form-select" t-att-disabled="this.state.busy"
                                    t-on-change="(event) => this.state.provider = event.target.value">
                                <option t-foreach="this.state.config.providers" t-as="provider" t-key="provider.value"
                                        t-att-value="provider.value" t-esc="provider.label"/>
                            </select>
                        </div>
                        <div class="col-12 col-lg-auto">
                            <button class="btn btn-primary" type="submit" t-att-disabled="this.state.busy || !this.state.topic">Ask</button>
                        </div>
                    </form>
                    <p t-if="!this.topics.length" role="status">The manual has no matching topic for your installed apps and version. Consult your implementation advisor for guidance.</p>
                    <div t-if="!this.state.config.professional &amp;&amp; this.state.config.online_allowed" class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="qing_ai_guide_title_consent"
                               t-att-checked="this.state.config.title_consent"
                               t-att-disabled="this.state.busy" t-on-change="(event) => this.changeTitleConsent(event)"/>
                        <label class="form-check-label" for="qing_ai_guide_title_consent">
                            Find related Professional guide titles. This sends the selected topic, QingERP version and required app identifier to the QingERP service center.
                        </label>
                    </div>
                </div>
                <div t-if="this.state.partial &amp;&amp; !this.state.answer" class="border rounded p-3 mt-3"
                     style="white-space: pre-wrap" aria-live="polite" t-esc="this.state.partial"/>
                <p t-if="this.state.busy &amp;&amp; !this.state.partial" role="status">Loading…</p>
                <p t-if="this.state.error" class="alert alert-danger" role="alert" t-esc="this.state.error"/>
                <article t-if="this.state.answer" aria-live="polite" class="border rounded p-3 mt-3">
                    <p t-if="this.state.answer.notice" role="status" class="text-muted" t-esc="this.state.answer.notice"/>
                    <div class="o_qing_ai_text" style="white-space: pre-wrap" t-esc="this.state.answer.answer"/>
                    <ul class="mt-3 mb-0">
                        <li t-foreach="this.state.answer.references" t-as="source" t-key="source.number">
                            <a t-if="source.url" t-att-href="source.url" target="_blank" rel="noopener noreferrer" t-esc="source.number + '. ' + source.chapter"/>
                            <button t-else="" type="button" class="btn btn-link p-0" t-att-disabled="this.state.busy"
                                    t-on-click="() => this.openSource(source)" t-esc="source.number + '. ' + source.chapter"/>
                            <span class="text-muted small ms-2" t-esc="source.version + ' · ' + source.revision"/>
                        </li>
                    </ul>
                    <p t-if="this.state.answer.titles.length" class="small text-muted mt-3 mb-0">
                        In the Professional knowledge library: <t t-esc="this.state.answer.titles.join(' · ')"/>.
                    </p>
                </article>
                <section t-if="this.state.source" class="border rounded p-3 mt-3" aria-live="polite">
                    <h2 class="h5" t-esc="this.state.source.title"/>
                    <p class="small text-muted" t-esc="this.state.source.chapter + ' · ' + this.state.source.module + ' · ' + this.state.source.version + ' · ' + this.state.source.revision"/>
                    <p class="mb-0" style="white-space: pre-wrap" t-esc="this.state.source.body"/>
                </section>
            </div>
        </main>
    </t>
</templates>
