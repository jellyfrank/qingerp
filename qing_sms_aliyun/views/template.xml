<odoo>
  <data>
    <record id="view_sms_aliyun_template_form" model="ir.ui.view">
      <field name="name">Aliyun SMS Template</field>
      <field name="model">qing.sms.aliyun.template</field>
      <field name="arch" type="xml">
        <form string="" class="">
          <sheet>
            <div class="oe_title">
              <label for="name" string="" class="oe_edit_only"/>
              <h1>
                <field name="name" />
              </h1>
            </div>
            <group>
              <field name="code"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="view_sms_aliyun_template_tree" model="ir.ui.view">
      <field name="name">Aliyun SMS Template</field>
      <field name="model">qing.sms.aliyun.template</field>
      <field name="priority">1</field>
      <field name="arch" type="xml">
        <list string="">
          <field name="name"/>
          <field name="code"/>
        </list>
      </field>
    </record>

    <record id="action_sms_aliyun_template" model="ir.actions.act_window">
      <field name="name">Aliyun SMS Template</field>
      <field name="path">aliyun_sms_template</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">qing.sms.aliyun.template</field>
      <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_sms_aliyun_template" name="SMS Template" parent="mommy_aliyun_sms_root" action="action_sms_aliyun_template" sequence="2"/>
<record id="menu_sms_aliyun_template" model="ir.ui.menu"><field name="active" eval="False"/></record>


  </data>
</odoo>
