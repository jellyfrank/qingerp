<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_mommy_aliyun_sms_config_form" model="ir.ui.view">
      <field name="name">aliyun sms config</field>
      <field name="model">qing.sms.aliyun.config</field>
      <field name="arch" type="xml">
        <form string="" class="">
          <header>
            <button name="action_migrate_configuration" type="object" string="迁移到通用短信" groups="base.group_system"/>
            <button name="action_test_configuration" type="object" string="测试配置" class="oe_highlight" groups="base.group_system" help="检查密钥认证和签名审核状态，不发送短信。"/>
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name" string="Name" class="oe_edit_only"/>
              <h1>
                <field name="name"/>
              </h1>
            </div>
            <group>
              <field name="key"/>
              <field name="secret" password="True"/>
              <field name="sign"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>


    <record id="view_mommy_aliyun_sms_config_list" model="ir.ui.view">
      <field name="name">aliyun sms config</field>
      <field name="model">qing.sms.aliyun.config</field>
      <field name="priority">1</field>
      <field name="arch" type="xml">
        <list string="">
          <field name="name"/>
          <field name="key"/>
          <field name="secret" password="True"/>
          <field name="sign"/>
        </list>
      </field>
    </record>

    <record id="action_mommy_aliyun_sms_config" model="ir.actions.act_window">
      <field name="path">aliyun_sms_config</field>
      <field name="name">Aliyun SMS Config</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">qing.sms.aliyun.config</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="mommy_aliyun_sms_root"  name="Aliyun SMS Config"  parent="base.menu_custom" groups="base.group_system"  sequence="2"/>
<record id="mommy_aliyun_sms_root" model="ir.ui.menu"><field name="active" eval="False"/></record>
    <menuitem id="mommy_aliyun_sms"  name="Aliyun SMS"  parent="mommy_aliyun_sms_root" action="action_mommy_aliyun_sms_config"  sequence="1"/>
<record id="mommy_aliyun_sms" model="ir.ui.menu"><field name="active" eval="False"/></record>

    <record id="view_sms_form" model="ir.ui.view">
      <field name="name">aliyun sms</field>
      <field name="model">sms.sms</field>
      <field name="inherit_id" ref="sms.sms_tsms_view_form"/>
      <field name="arch" type="xml">
        <field name="partner_id" position="after">
          <field name="service_provider"/>
          <field name="aliyun_company_id" invisible="service_provider != 'aliyun'"/>
          <field name="aliyun_template" invisible="service_provider != 'aliyun'"/>
        </field>
        <field name="body" position="after">
          <field name="aliyun_biz_id" invisible="service_provider != 'aliyun'"/>
          <field name="aliyun_request_id" invisible="service_provider != 'aliyun'"/>
          <field name="aliyun_error_msg" invisible="state != 'error' or service_provider != 'aliyun'"/>
        </field>
      </field>
    </record>
  </data>
</odoo>
