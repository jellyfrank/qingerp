<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.qing.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="qing_show_only_quotations" string="Show Only Quotations"
                         help="Show only draft and sent quotations in Quotations, and confirmed orders in Sales Orders. Disable to restore the standard menu filters.">
                    <field name="qing_show_only_quotations"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
