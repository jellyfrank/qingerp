<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Primary templates are copied before Qing Base's extension is applied. -->
    <t t-name="qing_sale.OrderLineListRenderer" t-inherit="account.SectionAndNoteListRenderer" t-inherit-mode="primary">
        <xpath expr="//thead/tr/t[@t-foreach='this.columns']/th[@t-else]" position="before">
            <th t-elif="column.type === 'qing_row_number'" class="o_qing_row_number text-center" scope="col">#</th>
        </xpath>
    </t>
    <!-- Re-resolve the sale row with Qing Base's inherited display cell. -->
    <t t-name="qing_sale.OrderLineRecordRow" t-inherit="sale.ListRenderer.RecordRow" t-inherit-mode="primary"/>
    <t t-name="qing_sale.TemplateLineRecordRow" t-inherit="sale_management.ListRenderer.RecordRow" t-inherit-mode="primary"/>
</templates>
