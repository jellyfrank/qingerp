<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_quotations_menu" model="ir.actions.server">
        <field name="name">Quotations</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['res.config.settings']._qing_sale_menu_action('quotation')</field>
    </record>
    <record id="action_sale_orders_menu" model="ir.actions.server">
        <field name="name">Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['res.config.settings']._qing_sale_menu_action('order')</field>
    </record>

    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.server,%d' % ref('action_sale_quotations_menu')"/>
    </record>
    <record id="sale.menu_sale_order" model="ir.ui.menu">
        <field name="action" eval="'ir.actions.server,%d' % ref('action_sale_orders_menu')"/>
    </record>
</odoo>
