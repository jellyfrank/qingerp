<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qing_audit_log_list" model="ir.ui.view">
        <field name="name">qing.audit.log.list</field>
        <field name="model">qing.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Logs" create="0" edit="0" delete="0">
                <field name="event_date"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <field name="field_names"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="view_qing_audit_log_form" model="ir.ui.view">
        <field name="name">qing.audit.log.form</field>
        <field name="model">qing.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="event_date"/>
                            <field name="user_id"/>
                            <field name="session_user_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="source"/>
                            <field name="is_sudo"/>
                        </group>
                    </group>
                    <group>
                        <field name="field_names"/>
                        <field name="changes" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_qing_audit_log_search" model="ir.ui.view">
        <field name="name">qing.audit.log.search</field>
        <field name="model">qing.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Logs">
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_id"/>
                <filter name="created" string="Created" domain="[('operation', '=', 'create')]"/>
                <filter name="updated" string="Updated" domain="[('operation', '=', 'write')]"/>
                <filter name="deleted" string="Deleted" domain="[('operation', '=', 'unlink')]"/>
                <group>
                    <filter name="group_by_user" string="User" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_model" string="Model" domain="[]" context="{'group_by': 'model_name'}"/>
                    <filter name="group_by_day" string="Day" domain="[]" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qing_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">qing.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qing_audit_log_search"/>
    </record>

    <menuitem id="menu_qing_audit_log" name="Audit Logs"
              parent="base.menu_security" action="action_qing_audit_log"
              sequence="80" groups="base.group_system"/>
</odoo>
