<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_qing_audit_purge" model="ir.cron">
        <field name="name">Qing Audit: Remove Expired Logs</field>
        <field name="model_id" ref="model_qing_audit_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qing_login_log_purge" model="ir.cron">
        <field name="name">Qing: Remove Expired Sign-in Logs</field>
        <field name="model_id" ref="model_qing_login_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qing_telemetry_heartbeat" model="ir.cron">
        <field name="name">QingERP: Installation Heartbeat</field>
        <field name="model_id" ref="base.model_ir_config_parameter"/>
        <field name="state">code</field>
        <field name="code">model._cron_qing_telemetry_heartbeat()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_qing_access_event_purge" model="ir.cron">
        <field name="name">Qing Permission Diagnostics: Remove Expired Events</field>
        <field name="model_id" ref="model_qing_access_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
