<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_access_experience" model="res.groups.privilege">
        <field name="name">Permission Requests and Diagnostics</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>
    <record id="group_access_request_handler" model="res.groups">
        <field name="name">Permission Request Handler</field>
        <field name="privilege_id" ref="privilege_access_experience"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_access_diagnostic" model="res.groups">
        <field name="name">Permission Experience Diagnostic</field>
        <field name="privilege_id" ref="privilege_access_experience"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
</odoo>
