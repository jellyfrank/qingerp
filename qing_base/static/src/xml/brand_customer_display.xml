<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Point of sale customer display: "Powered by" + the Odoo logo. This
         file is only in the display's own bundle, which exists with the POS
         app. -->
    <t t-inherit="point_of_sale.CustomerDisplayFooter" t-inherit-mode="extension">
        <xpath expr="//OdooLogo[@t-else]" position="replace"/>
        <xpath expr="//OdooLogo" position="replace">
            <strong class="ms-1">QingERP</strong>
        </xpath>
    </t>
</templates>
