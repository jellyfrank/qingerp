<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fapiao_ocr_form" model="ir.ui.view">
        <field name="name">qing.fapiao.ocr.form</field><field name="model">qing.fapiao.ocr</field>
        <field name="arch" type="xml">
            <form string="本地识别并核对">
                <div class="alert alert-info" role="status">票据仅在本服务器处理。每次一张票：PNG、JPEG 或未加密单页 PDF，最大 10 MB。识别结果可能有误，请对照原票逐项核对；本操作仅生成草稿。</div>
                <field name="recognized" invisible="1"/><field name="fapiao_id" invisible="1"/>
                <group>
                    <field name="company_id" readonly="recognized"/>
                    <field name="source_file" filename="source_filename"/>
                    <field name="source_filename" invisible="1"/>
                </group>
                <group invisible="not recognized">
                    <group>
                        <field name="direction"/><field name="kind"/><field name="color"/>
                        <field name="original_number" invisible="color != 'red'"/>
                        <field name="partner_id" options="{'no_create': True}"/><field name="currency_id"/>
                        <field name="number"/><field name="code"/><field name="invoice_date"/>
                    </group>
                    <group>
                        <field name="buyer_name"/><field name="buyer_tax_id"/>
                        <field name="seller_name"/><field name="seller_tax_id"/>
                        <field name="amount_untaxed"/><field name="amount_tax"/><field name="invoice_total"/>
                    </group>
                </group>
                <group invisible="not recognized">
                    <field name="ocr_engine"/><field name="ocr_text"/>
                    <field name="reviewed"/>
                </group>
                <footer>
                    <button name="action_recognize" string="本地识别 / 重新识别" type="object" class="btn-secondary"/>
                    <button name="action_create_draft" string="生成税票草稿" type="object" class="btn-primary" invisible="not recognized"/>
                    <button string="关闭" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_fapiao_ocr" model="ir.actions.act_window">
        <field name="name">本地识别导入</field><field name="res_model">qing.fapiao.ocr</field>
        <field name="view_mode">form</field><field name="target">new</field>
    </record>
    <record id="view_fapiao_list_local_ocr" model="ir.ui.view">
        <field name="name">qing.fapiao.list.local.ocr</field>
        <field name="model">qing.fapiao</field>
        <field name="inherit_id" ref="qing_account_fapiao.view_fapiao_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <header>
                    <button name="%(action_fapiao_ocr)d" type="action" string="本地识别导入"
                            class="btn-secondary" display="always" groups="account.group_account_manager"/>
                </header>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_fapiao_ocr" name="本地识别导入" parent="qing_account_fapiao.menu_fapiao_root"
              action="action_fapiao_ocr" sequence="20" groups="account.group_account_manager" active="False"/>
</odoo>
