<odoo>
    <record id="view_res_partner_form_crm" model="ir.ui.view">
        <field name="name">qing.crm.res.partner.form</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_qing_crm_enroll" type="object" class="oe_stat_button" icon="fa-user-plus" string="Add to CRM" groups="sales_team.group_sale_salesman" invisible="parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
