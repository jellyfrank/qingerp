<odoo>
    <record id="view_crm_pool_list" model="ir.ui.view">
        <field name="name">qing.crm.pool.list</field>
        <field name="model">qing.crm.pool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="is_default"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_crm_pool_form" model="ir.ui.view">
        <field name="name">qing.crm.pool.form</field>
        <field name="model">qing.crm.pool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_crm_pool_entry_list" model="ir.ui.view">
        <field name="name">qing.crm.pool.entry.list</field>
        <field name="model">qing.crm.pool.entry</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="city" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="lifecycle_stage" optional="show" widget="badge"/>
                <field name="customer_grade" optional="show" widget="badge"/>
                <field name="available_since"/>
                <field name="pool_id" groups="sales_team.group_sale_manager"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_claim" type="object" string="Claim" class="btn-primary"/>
            </list>
        </field>
    </record>
    <record id="view_crm_pool_entry_search" model="ir.ui.view">
        <field name="name">qing.crm.pool.entry.search</field>
        <field name="model">qing.crm.pool.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city"/>
                <field name="country_id"/>
                <filter name="grade_a" string="Grade A" domain="[('customer_grade','=','a')]"/>
                <group>
                    <filter name="pool" string="Pool" context="{'group_by':'pool_id'}"/>
                    <filter name="stage" string="Lifecycle" context="{'group_by':'lifecycle_stage'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_crm_public_pool" model="ir.actions.act_window">
        <field name="name">Public Pool</field>
        <field name="res_model">qing.crm.pool.entry</field>
        <field name="view_mode">list</field>
        <field name="domain">[('active','=',True)]</field>
    </record>
    <record id="action_crm_pool" model="ir.actions.act_window">
        <field name="name">Customer Pools</field>
        <field name="res_model">qing.crm.pool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
