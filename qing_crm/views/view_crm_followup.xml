<odoo>
    <record id="view_crm_followup_list" model="ir.ui.view">
        <field name="name">qing.crm.followup.list</field>
        <field name="model">qing.crm.followup</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="occurred_at"/>
                <field name="partner_name"/>
                <field name="owner_id"/>
                <field name="channel"/>
                <field name="result" widget="badge"/>
                <field name="effective_contact"/>
                <field name="duration_minutes" sum="Total Duration"/>
                <field name="lifecycle_stage" optional="show"/>
                <field name="created_by_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_crm_followup_form" model="ir.ui.view">
        <field name="name">qing.crm.followup.form</field>
        <field name="model">qing.crm.followup</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="partner_name"/><field name="occurred_at"/><field name="owner_id"/><field name="crm_team_id"/></group>
                        <group><field name="channel"/><field name="result"/><field name="effective_contact"/><field name="duration_minutes"/></group>
                    </group>
                    <group string="Snapshot"><field name="lifecycle_stage"/><field name="health_status"/><field name="customer_grade"/></group>
                    <group><field name="note"/><field name="attachment_ids" widget="many2many_binary"/><field name="next_activity_id"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_crm_followup_search" model="ir.ui.view">
        <field name="name">qing.crm.followup.search</field>
        <field name="model">qing.crm.followup</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_name"/>
                <field name="owner_id"/>
                <filter name="effective" string="Effective Contact" domain="[('effective_contact','=',True)]"/>
                <group>
                    <filter name="date" string="Date" context="{'group_by':'occurred_at:month'}"/>
                    <filter name="owner" string="Owner" context="{'group_by':'owner_id'}"/>
                    <filter name="team" string="Sales Team" context="{'group_by':'crm_team_id'}"/>
                    <filter name="channel" string="Channel" context="{'group_by':'channel'}"/>
                    <filter name="result" string="Result" context="{'group_by':'result'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_crm_followup_pivot" model="ir.ui.view">
        <field name="name">qing.crm.followup.pivot</field>
        <field name="model">qing.crm.followup</field>
        <field name="arch" type="xml">
            <pivot string="Follow-up Analysis">
                <field name="occurred_at" type="row" interval="month"/>
                <field name="owner_id" type="col"/>
                <field name="duration_minutes" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_crm_followup_graph" model="ir.ui.view">
        <field name="name">qing.crm.followup.graph</field>
        <field name="model">qing.crm.followup</field>
        <field name="arch" type="xml">
            <graph string="Follow-up Trend" type="bar">
                <field name="occurred_at" interval="month"/>
                <field name="owner_id"/>
            </graph>
        </field>
    </record>
    <record id="action_crm_followup" model="ir.actions.act_window">
        <field name="name">Follow-up Records</field>
        <field name="res_model">qing.crm.followup</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_crm_followup_report" model="ir.actions.act_window">
        <field name="name">Follow-up Analysis</field>
        <field name="res_model">qing.crm.followup</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
