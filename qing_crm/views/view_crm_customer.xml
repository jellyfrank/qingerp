<odoo>
    <record id="view_crm_customer_list" model="ir.ui.view">
        <field name="name">qing.crm.customer.list</field>
        <field name="model">qing.partner.role</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="state == 'disabled'">
                <field name="partner_id"/>
                <field name="lifecycle_stage" widget="badge" optional="show"/>
                <field name="health_status" widget="badge" optional="show"/>
                <field name="customer_grade" widget="badge" optional="show"/>
                <field name="effective_owner_id" optional="show"/>
                <field name="crm_team_id" optional="show"/>
                <field name="last_followup_at" optional="show"/>
                <field name="next_activity_date" optional="show"/>
                <field name="state" widget="badge" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_followup_wizard" type="object" string="Follow Up" class="btn-link"/>
            </list>
        </field>
    </record>
    <record id="view_crm_customer_form" model="ir.ui.view">
        <field name="name">qing.crm.customer.form</field>
        <field name="model">qing.partner.role</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_open_followup_wizard" string="Log Follow-up" type="object" class="btn-primary"/>
                    <button name="action_open_assignment_wizard" string="Assignment" type="object"/>
                    <button name="action_open_status_wizard" string="Update Status" type="object"/>
                    <field name="lifecycle_stage" widget="statusbar" statusbar_visible="potential,qualified,first_order,active,dormant,lost"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="partner_id" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="state" readonly="1"/>
                            <field name="pool_state" readonly="1"/>
                            <field name="pool_id" readonly="1" invisible="pool_state != 'public'"/>
                        </group>
                        <group>
                            <field name="effective_owner_id" readonly="1"/>
                            <field name="crm_team_id" readonly="1"/>
                            <field name="shared_user_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <group string="Customer Status">
                        <field name="health_status" readonly="1" widget="badge"/>
                        <field name="customer_grade" readonly="1" widget="badge"/>
                        <field name="last_followup_at" readonly="1"/>
                        <field name="last_effective_followup_at" readonly="1"/>
                        <field name="next_activity_date" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Follow-ups">
                            <field name="followup_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="occurred_at"/>
                                    <field name="channel"/>
                                    <field name="result" widget="badge"/>
                                    <field name="effective_contact"/>
                                    <field name="duration_minutes"/>
                                    <field name="created_by_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="History">
                            <field name="history_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="occurred_at"/>
                                    <field name="event_type" widget="badge"/>
                                    <field name="owner_id"/>
                                    <field name="lifecycle_stage"/>
                                    <field name="health_status"/>
                                    <field name="customer_grade"/>
                                    <field name="performed_by_id"/>
                                    <field name="previous_owner_id" optional="hide"/>
                                    <field name="previous_lifecycle_stage" optional="hide"/>
                                    <field name="previous_health_status" optional="hide"/>
                                    <field name="previous_customer_grade" optional="hide"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_crm_customer_search" model="ir.ui.view">
        <field name="name">qing.crm.customer.search</field>
        <field name="model">qing.partner.role</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="effective_owner_id"/>
                <field name="crm_team_id"/>
                <filter name="need_attention" string="Needs Attention" domain="[('health_status','in',['attention','at_risk','dormant'])]"/>
                <filter name="no_next" string="No Next Activity" domain="[('next_activity_date','=',False)]"/>
                <group>
                    <filter name="owner" string="Owner" context="{'group_by':'effective_owner_id'}"/>
                    <filter name="team" string="Sales Team" context="{'group_by':'crm_team_id'}"/>
                    <filter name="stage" string="Lifecycle" context="{'group_by':'lifecycle_stage'}"/>
                    <filter name="health" string="Health" context="{'group_by':'health_status'}"/>
                    <filter name="grade" string="Grade" context="{'group_by':'customer_grade'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_my_crm_customers" model="ir.actions.act_window">
        <field name="name">My Customers</field>
        <field name="res_model">qing.partner.role</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('crm_managed','=',True),('role','=','customer'),('pool_state','=','private'),('effective_owner_id','=',uid)]</field>
        <field name="context">{'search_default_owner': 0}</field>
    </record>
    <record id="action_collaborating_crm_customers" model="ir.actions.act_window">
        <field name="name">Collaborating Customers</field>
        <field name="res_model">qing.partner.role</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('crm_managed','=',True),('role','=','customer'),('pool_state','=','private'),('shared_user_ids','in',[uid])]</field>
    </record>
    <record id="action_team_crm_customers" model="ir.actions.act_window">
        <field name="name">Team Customers</field>
        <field name="res_model">qing.partner.role</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('crm_managed','=',True),('role','=','customer'),('pool_state','=','private')]</field>
    </record>
    <record id="action_all_crm_customers" model="ir.actions.act_window">
        <field name="name">All Managed Customers</field>
        <field name="res_model">qing.partner.role</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('crm_managed','=',True),('role','=','customer')]</field>
    </record>
    <record id="action_my_crm_customers_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_crm_customer_list"/>
        <field name="act_window_id" ref="action_my_crm_customers"/>
    </record>
    <record id="action_my_crm_customers_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_customer_form"/>
        <field name="act_window_id" ref="action_my_crm_customers"/>
    </record>
    <record id="action_collaborating_crm_customers_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_crm_customer_list"/>
        <field name="act_window_id" ref="action_collaborating_crm_customers"/>
    </record>
    <record id="action_collaborating_crm_customers_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_customer_form"/>
        <field name="act_window_id" ref="action_collaborating_crm_customers"/>
    </record>
    <record id="action_team_crm_customers_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_crm_customer_list"/>
        <field name="act_window_id" ref="action_team_crm_customers"/>
    </record>
    <record id="action_team_crm_customers_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_customer_form"/>
        <field name="act_window_id" ref="action_team_crm_customers"/>
    </record>
    <record id="action_all_crm_customers_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_crm_customer_list"/>
        <field name="act_window_id" ref="action_all_crm_customers"/>
    </record>
    <record id="action_all_crm_customers_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_crm_customer_form"/>
        <field name="act_window_id" ref="action_all_crm_customers"/>
    </record>
    <record id="action_crm_customer_history" model="ir.actions.act_window">
        <field name="name">Customer History</field>
        <field name="res_model">qing.crm.customer.event</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_crm_customer_event_list" model="ir.ui.view">
        <field name="name">qing.crm.customer.event.list</field>
        <field name="model">qing.crm.customer.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="occurred_at"/>
                <field name="partner_name"/>
                <field name="event_type" widget="badge"/>
                <field name="owner_id"/>
                <field name="lifecycle_stage"/>
                <field name="health_status"/>
                <field name="customer_grade"/>
                <field name="performed_by_id"/>
                <field name="previous_owner_id" optional="hide"/>
                <field name="previous_lifecycle_stage" optional="hide"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
</odoo>
