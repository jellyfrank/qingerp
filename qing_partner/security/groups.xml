<odoo>
    <record id="privilege_partner" model="res.groups.privilege">
        <field name="name">Partner Maintenance</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_partner_editor" model="res.groups">
        <field name="name">Contact Details Editor</field>
        <field name="privilege_id" ref="privilege_partner"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_partner_manager" model="res.groups">
        <field name="name">Master Data and Role Manager</field>
        <field name="privilege_id" ref="privilege_partner"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_partner_editor'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin')), Command.link(ref('base.user_root'))]"/>
    </record>
</odoo>
