<odoo>
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">qing.partner.res.partner.form</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside"><field name="qing_can_manage" invisible="1"/></xpath>
            <xpath expr="//sheet//field[@name='vat']" position="attributes"><attribute name="readonly" add="id and not qing_can_manage" separator=" or "/></xpath>
            <xpath expr="(//field[@name='parent_id'])[1]" position="attributes"><attribute name="readonly" add="id and not qing_can_manage" separator=" or "/></xpath>
            <xpath expr="//page[@name='sales_purchases']/group[1]" position="before">
                <div name="qing_partner_identities" class="d-flex flex-wrap gap-4 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <field name="qing_is_customer" string="Customer" nolabel="1" readonly="not qing_can_manage or (parent_id and not is_company)"/>
                        <label for="qing_is_customer" string="Customer"/>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <field name="qing_is_supplier" string="Supplier" nolabel="1" readonly="not qing_can_manage or (parent_id and not is_company)"/>
                        <label for="qing_is_supplier" string="Supplier"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//group[@name='sale']" position="attributes">
                <attribute name="invisible" add="not qing_is_customer" separator=" or "/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="attributes">
                <attribute name="invisible" add="not qing_is_supplier" separator=" or "/>
            </xpath>
            <xpath expr="//group[@name='sale']/field[@name='user_id']" position="attributes">
                <attribute name="readonly">not qing_can_manage</attribute>
            </xpath></field>
    </record>
    <record id="view_res_partner_purchase_form" model="ir.ui.view">
        <field name="name">qing.partner.res.partner.purchase.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="buyer_id" position="attributes"><attribute name="readonly">not qing_can_manage</attribute></field>
        </field>
    </record>
    <record id="view_res_partner_search" model="ir.ui.view">
        <field name="name">qing.partner.res.partner.search</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml"><xpath expr="//search" position="inside"><separator/><filter name="qing_customer" string="Customer Role" domain="[('qing_is_customer','=',True)]"/><filter name="qing_supplier" string="Supplier Role" domain="[('qing_is_supplier','=',True)]"/></xpath></field>
    </record>
    <record id="action_customer" model="ir.actions.act_window"><field name="name">Customers</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('qing_is_customer','=',True)]</field></record>
    <record id="action_supplier" model="ir.actions.act_window"><field name="name">Suppliers</field><field name="res_model">res.partner</field><field name="view_mode">list,form</field><field name="domain">[('qing_is_supplier','=',True)]</field></record>
    <record id="account.res_partner_action_customer" model="ir.actions.act_window"><field name="context">{'search_default_qing_customer': 1, 'res_partner_search_mode': 'customer', 'default_is_company': True}</field></record>
    <record id="account.res_partner_action_supplier" model="ir.actions.act_window"><field name="context">{'search_default_qing_supplier': 1, 'res_partner_search_mode': 'supplier', 'default_is_company': True}</field></record>
</odoo>
