<odoo>
    <record id="view_partner_team_list" model="ir.ui.view">
        <field name="name">qing.partner.team.list</field><field name="model">qing.partner.team</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="member_ids" widget="many2many_tags"/></list></field>
    </record>
    <record id="view_partner_team_form" model="ir.ui.view">
        <field name="name">qing.partner.team.form</field><field name="model">qing.partner.team</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id" readonly="id"/><field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/></group></sheet></form></field>
    </record>
    <record id="action_partner_team" model="ir.actions.act_window"><field name="name">Business Teams</field><field name="res_model">qing.partner.team</field><field name="view_mode">list,form</field></record>
</odoo>
