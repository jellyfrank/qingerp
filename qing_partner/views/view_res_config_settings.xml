<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">qing.partner.res.config.settings.form</field><field name="model">res.config.settings</field><field name="inherit_id" ref="qing_base.view_res_config_settings_form"/>
        <field name="arch" type="xml"><xpath expr="//app[@name='qing_advanced_settings']" position="inside"><block title="Business Partners" name="qing_partner_settings"><setting string="Require Enabled Business Roles" company_dependent="1" help="Enable after assigning and reviewing roles. New quotations, purchase orders and invoices require an enabled role in their company. Credit notes remain available for historical corrections."><field name="qing_partner_enforce_roles"/></setting></block></xpath></field>
    </record>
</odoo>
