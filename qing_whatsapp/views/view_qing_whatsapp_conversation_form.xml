<?xml version="1.0" ?>
<odoo>
    <record id="view_qing_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">qing.whatsapp.conversation.form</field>
        <field name="model">qing.whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_open_discuss" string="Open WhatsApp chat" type="object" class="btn-primary"/>
                    <button class="btn-primary" name="action_compose" string="Send WhatsApp" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="account_id" readonly="1"/>
                        <field name="number"/>
                        <field name="partner_id"/>
                        <field name="owner_id"/>
                        <field name="window_until"/>
                    </group>
                    <notebook>
                        <page string="Messages">
                            <field name="whatsapp_message_ids" readonly="1">
                                <list create="0">
                                    <field name="create_date"/>
                                    <field name="direction"/>
                                    <field name="kind"/>
                                    <field name="body"/>
                                    <field name="state"/>
                                    <field name="error_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


</odoo>
