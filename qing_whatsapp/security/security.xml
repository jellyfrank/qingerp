<odoo>
    <record id="privilege_whatsapp" model="res.groups.privilege"><field name="name">Qing WhatsApp</field></record>
    <record id="group_user" model="res.groups">
        <field name="name">Operator</field><field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field><field name="privilege_id" ref="privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_user'))]"/>
    </record>
</odoo>
