<odoo>
    <record id="view_qing_whatsapp_compose_form" model="ir.ui.view"><field name="name">qing.whatsapp.compose.form</field><field name="model">qing.whatsapp.compose</field><field name="arch" type="xml"><form><group><field name="conversation_id" invisible="1"/><field name="account_id"/><field name="number"/><field name="partner_id"/><field name="kind"/><field name="template_id" domain="[('account_id', '=', account_id), ('status', '=', 'APPROVED')]" invisible="kind != 'template'"/><field name="header_value" invisible="kind != 'template'"/><field name="parameter_values" invisible="kind != 'template'"/><field name="button_values" invisible="kind != 'template'"/><field name="body" invisible="kind not in ['text','image','document','video']"/><field name="upload_name" invisible="1"/><field name="upload_data" filename="upload_name" invisible="kind not in ['template','image','document','audio','video']"/><field name="attachment_id" invisible="kind not in ['template','image','document','audio','video']"/></group><footer><button name="action_send" type="object" string="Queue message" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="action_compose" model="ir.actions.act_window"><field name="name">New message</field><field name="res_model">qing.whatsapp.compose</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="menu_compose" name="New message" parent="menu_root" action="action_compose" sequence="5"/>
</odoo>
