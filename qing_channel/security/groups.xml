<odoo>
    <record id="privilege_channel" model="res.groups.privilege">
        <field name="name">Sales Channels</field>
    </record>
    <record id="group_channel_user" model="res.groups">
        <field name="name">Channel Operator</field>
        <field name="privilege_id" ref="privilege_channel"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_channel_manager" model="res.groups">
        <field name="name">Channel Manager</field>
        <field name="privilege_id" ref="privilege_channel"/>
        <field name="implied_ids" eval="[Command.link(ref('group_channel_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_channel_manager'))]"/>
    </record>
</odoo>
