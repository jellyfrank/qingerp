<odoo>
    <record id="privilege_display" model="res.groups.privilege">
        <field name="name">Qing Display</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>
    <record id="group_display_viewer" model="res.groups">
        <field name="name">Display Viewer</field>
        <field name="privilege_id" ref="privilege_display"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_display_viewer'))]"/>
    </record>
</odoo>
