<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">account.move.form.qing.accrual</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info" role="status"
                     invisible="not qing_accrual_batch_id and not qing_accrual_reversal_batch_id">
                    暂估凭证由批次管理，不能直接编辑或删除。过账和冲回请进入关联批次操作。
                    <field name="qing_accrual_batch_id" readonly="1"/><field name="qing_accrual_reversal_batch_id" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="attributes">
                <attribute name="invisible" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//button[@name='%(account.action_view_account_move_reversal)d']" position="attributes">
                <attribute name="invisible" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="(//field[@name='ref'])[2]" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
            <xpath expr="(//field[@name='journal_id'])[2]" position="attributes">
                <attribute name="readonly" add="qing_accrual_batch_id or qing_accrual_reversal_batch_id" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
