<odoo>
    <record id="view_sale_order_form_b2b_stock" model="ir.ui.view">
        <field name="name">sale.order.form.b2b.inventory</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="b2b_backorder_date" invisible="not b2b_backorder_date"/>
                <field name="b2b_backorder_quantity" invisible="not b2b_backorder_date"/>
            </xpath>
        </field>
    </record>
</odoo>
