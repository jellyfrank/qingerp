<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qing_fapiao_provider_list" model="ir.ui.view">
        <field name="name">qing.fapiao.provider.list</field>
        <field name="model">qing.fapiao.provider</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/><field name="seller_tax_id"/><field name="environment"/><field name="enabled"/></list>
        </field>
    </record>
    <record id="view_qing_fapiao_provider_form" model="ir.ui.view">
        <field name="name">qing.fapiao.provider.form</field>
        <field name="model">qing.fapiao.provider</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="alert alert-info" role="alert">Select an installed provider adapter. Test and production accounts are separate. Company, adapter, and environment are locked after the first order. The seller tax ID can be changed; existing orders keep their saved tax ID.</div>
                <group><field name="name"/><field name="code"/><field name="company_id" groups="base.group_multi_company"/><field name="seller_tax_id"/><field name="environment"/><field name="enabled"/></group>
            </sheet></form>
        </field>
    </record>
    <record id="action_fapiao_provider" model="ir.actions.act_window">
        <field name="name">Invoice Provider Accounts</field><field name="res_model">qing.fapiao.provider</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fapiao_interface_root" name="Invoice Interfaces" sequence="90" groups="group_fapiao_manager"/>
    <menuitem id="menu_fapiao_provider" name="Provider Accounts" parent="menu_fapiao_interface_root" action="action_fapiao_provider" sequence="20" groups="group_fapiao_manager"/>
</odoo>
