<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_signature_form" model="ir.ui.view">
        <field name="name">qing.repair.signature.form</field>
        <field name="model">qing.repair.signature</field>
        <field name="arch" type="xml">
            <form string="Customer Signature">
                <group>
                    <field name="repair_id" options="{'no_open': True}"/>
                    <field name="kind"/>
                    <field name="price_hash" invisible="1"/>
                    <field name="signed_by"/>
                    <field name="signature" widget="signature" options="{'full_name': 'signed_by', 'size': [0, 180]}"/>
                </group>
                <footer>
                    <button name="action_sign" type="object" string="Confirm Signature" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
