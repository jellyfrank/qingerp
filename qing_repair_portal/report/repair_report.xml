<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_repair" model="ir.actions.report">
        <field name="name">Customer Repair Order</field>
        <field name="model">repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">qing_repair_portal.report_repair</field>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">object.name</field>
    </record>
    <template id="report_repair">
        <t t-call="web.html_container">
            <style>
                .qing_repair_pdf .qing_repair_signature { page-break-inside: avoid; }
            </style>
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page qing_repair_pdf">
                        <t t-set="repair" t-value="o.with_context(lang=o.partner_id.lang)"/>
                        <t t-set="lines" t-value="repair._qing_customer_lines()"/>
                        <t t-call="qing_repair_portal.repair_body" t-lang="o.partner_id.lang"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
