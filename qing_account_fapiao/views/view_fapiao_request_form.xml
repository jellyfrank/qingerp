<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fapiao_request_list" model="ir.ui.view">
        <field name="name">qing.fapiao.request.list</field><field name="model">qing.fapiao.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="name"/><field name="partner_id"/><field name="kind"/><field name="amount_untaxed"/>
                <field name="amount_tax"/><field name="amount_total"/><field name="currency_id"/>
                <field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
                <field name="submitted_at" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_fapiao_request_form" model="ir.ui.view">
        <field name="name">qing.fapiao.request.form</field><field name="model">qing.fapiao.request</field>
        <field name="arch" type="xml">
            <form string="Tax Invoice Request">
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_record_invoice" type="object" string="Record Issued Invoice" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel / Reject" invisible="state not in ('draft', 'submitted', 'approved')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state not in ('submitted', 'approved', 'cancelled')"/>
                    <button name="action_open_invoice" type="object" string="Open Tax Invoice" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">Submit reserves the requested amount and tax. After approval, issue the invoice externally and record its details here. This action does not issue an invoice or post accounting entries.</div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="partner_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="amount_untaxed"/><field name="amount_tax"/><field name="amount_total"/>
                            <field name="fapiao_id" invisible="not fapiao_id"/><field name="fapiao_state" invisible="not fapiao_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Request Details">
                            <group>
                                <group><field name="buyer_partner_id" readonly="1" options="{'no_create': True}"/><field name="buyer_name" readonly="state != 'draft'"/><field name="buyer_tax_id" readonly="state != 'draft'"/></group>
                                <group><field name="seller_partner_id" readonly="1" options="{'no_create': True}"/><field name="seller_name" readonly="state != 'draft'"/><field name="seller_tax_id" readonly="state != 'draft'"/></group>
                            </group>
                            <p>Review item descriptions, quantities, tax classification codes, amounts and taxes. For a partial request, reduce the quantity, amount and tax together as appropriate.</p>
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="source_line_id" domain="[('company_id', '=', parent.company_id), ('currency_id', '=', parent.currency_id), ('move_id.move_type', '=', 'out_invoice'), ('move_id.state', '=', 'posted'), ('display_type', '=', 'product')]" options="{'no_create': True}"/>
                                    <field name="move_id" optional="show"/><field name="description"/><field name="quantity"/>
                                    <field name="tax_classification_id" options="{'no_create': True}"/>
                                    <field name="tax_code" readonly="tax_classification_id"/>
                                    <field name="tax_classification_name" optional="hide"/>
                                    <field name="tax_description"/><field name="amount_untaxed"/><field name="amount_tax"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <field name="note" readonly="state != 'draft'" placeholder="Internal notes"/>
                        </page>
                        <page string="Issued Invoice" invisible="state not in ('approved', 'done')">
                            <group>
                                <group><field name="result_number" readonly="state != 'approved'"/><field name="result_code" readonly="state != 'approved'"/><field name="result_date" readonly="state != 'approved'"/></group>
                                <group><field name="result_amount_untaxed" readonly="state != 'approved'"/><field name="result_amount_tax" readonly="state != 'approved'"/>
                                    <field name="result_filename" invisible="1"/><field name="result_file" filename="result_filename" readonly="state != 'approved'"/></group>
                            </group>
                            <p>Verify the file, buyer, seller, items, amount and tax and select the confirmation below. Changing result details clears this confirmation.</p>
                            <div class="d-flex align-items-center gap-2">
                                <field name="result_checked" readonly="state != 'approved'"/>
                                <label for="result_checked"/>
                            </div>
                        </page>
                        <page string="Audit">
                            <group><field name="submitted_by"/><field name="submitted_at"/><field name="approved_by"/><field name="approved_at"/>
                                <field name="completed_by"/><field name="completed_at"/><field name="cancelled_by"/><field name="cancelled_at"/>
                                <field name="reset_by"/><field name="reset_at"/></group>
                        </page>
                    </notebook>
                    <group><field name="cancel_reason" readonly="state in ('done', 'cancelled')" placeholder="Required when cancelling or rejecting"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fapiao_request" model="ir.actions.act_window">
        <field name="name">Invoice Requests</field><field name="res_model">qing.fapiao.request</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fapiao_request" name="Invoice Requests" parent="menu_fapiao_root" action="action_fapiao_request" sequence="15" groups="account.group_account_manager"/>
    <record id="action_create_fapiao_request" model="ir.actions.server">
        <field name="name">Create Invoice Request</field><field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/><field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field><field name="code">action = records.action_create_fapiao_request()</field>
    </record>
</odoo>
