<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">account.move.form.fapiao</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_fapiao_request" type="object" string="Create Invoice Request"
                        groups="account.group_account_manager" invisible="state != 'posted' or move_type != 'out_invoice'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_fapiao_requests" type="object"
                        class="oe_stat_button" icon="request_quote"
                        groups="account.group_account_manager" invisible="move_type != 'out_invoice'">
                    <field name="qing_fapiao_request_count" widget="statinfo" string="Invoice Requests"/>
                </button>
                <button name="action_open_fapiao" type="object"
                        class="oe_stat_button" icon="receipt_long"
                        groups="account.group_account_manager" invisible="move_type == 'entry'">
                    <field name="qing_fapiao_count" widget="statinfo" string="Tax Invoice Registrations"/>
                </button>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="税票额度" groups="account.group_account_manager" invisible="move_type == 'entry'">
                    <group><field name="qing_fapiao_remaining_untaxed"/><field name="qing_fapiao_remaining_tax"/></group>
                    <group string="Invoice Requests" invisible="move_type != 'out_invoice'">
                        <field name="qing_fapiao_reserved_untaxed"/><field name="qing_fapiao_reserved_tax"/>
                        <field name="qing_fapiao_request_remaining_untaxed"/><field name="qing_fapiao_request_remaining_tax"/>
                    </group>
                    <field name="qing_fapiao_allocation_ids" readonly="1">
                        <list create="0" delete="0"><field name="fapiao_id"/><field name="amount_untaxed"/><field name="amount_tax"/><field name="state"/></list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_out_invoice_tree_fapiao_status" model="ir.ui.view">
        <field name="name">account.out.invoice.list.fapiao.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="qing_fapiao_status" widget="badge" optional="show"
                       groups="account.group_account_manager"
                       decoration-muted="qing_fapiao_status == 'not_invoiced'"
                       decoration-warning="qing_fapiao_status in ('draft_request', 'requested', 'pending_registration', 'unallocated')"
                       decoration-info="qing_fapiao_status == 'partial'"
                       decoration-success="qing_fapiao_status == 'invoiced'"/>
            </field>
        </field>
    </record>
</odoo>
