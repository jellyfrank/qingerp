<odoo>
    <record id="view_res_city_list" model="ir.ui.view">
        <field name="name">qing.address.cn.res.city.list</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="qing_cn_code" optional="hide"/>
            </field>
        </field>
    </record>
    <record id="view_res_city_form" model="ir.ui.view">
        <field name="name">qing.address.cn.res.city.form</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.res_city_view_form"/>
        <field name="arch" type="xml">
            <field name="state_id" position="after">
                <field name="qing_cn_code"/>
            </field>
        </field>
    </record>
    <record id="action_china_cities" model="ir.actions.act_window">
        <field name="name">China Cities</field>
        <field name="res_model">res.city</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('qing_cn_code', '!=', False)]</field>
        <field name="context" eval="{'default_country_id': ref('base.cn')}"/>
    </record>
</odoo>
