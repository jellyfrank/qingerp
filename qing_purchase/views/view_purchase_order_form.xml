<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.qing.purchase</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/widget[@name='purchase_file_uploader']" position="before">
                <button name="action_qing_create_bill"
                        type="object"
                        string="Create Bill"
                        class="oe_highlight"
                        invisible="state != 'purchase' or invoice_status != 'to invoice'"/>
            </xpath>
        </field>
    </record>
</odoo>
