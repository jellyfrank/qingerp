#. module: qing_payment_wechatpay
#: model_terms:ir.ui.view,arch_db:qing_payment_wechatpay.wechatpay_jsapi_payform
msgid ""
"<span data-key=\"missing\">Payment parameters are missing. Refresh the page and try again.</span>\n"
"                <span data-key=\"invalid\">Payment parameters could not be read. Refresh the page and try again.</span>\n"
"                <span data-key=\"no_bridge\">WeChat Pay is not available here. Open this page in WeChat.</span>\n"
"                <span data-key=\"opening\">Opening WeChat Pay...</span>\n"
"                <span data-key=\"paid\">Payment succeeded. Redirecting...</span>\n"
"                <span data-key=\"cancelled\">You cancelled the payment. Tap the button to try again.</span>\n"
"                <span data-key=\"failed\">WeChat Pay could not be opened. Tap the button to try again.</span>\n"
"                <span data-key=\"waiting\">Waiting for WeChat Pay to be ready...</span>"
msgstr "<span data-key=\"missing\">缺少支付参数，请刷新页面后重试。</span>\n                <span data-key=\"invalid\">无法读取支付参数，请刷新页面后重试。</span>\n                <span data-key=\"no_bridge\">未检测到微信支付环境，请在微信内打开此页面。</span>\n                <span data-key=\"opening\">正在拉起微信支付...</span>\n                <span data-key=\"paid\">支付成功，正在跳转...</span>\n                <span data-key=\"cancelled\">你已取消支付，可以点击按钮重新支付。</span>\n                <span data-key=\"failed\">无法拉起微信支付，可以点击按钮重试。</span>\n                <span data-key=\"waiting\">正在等待微信支付环境就绪...</span>"

