<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="payment.provider" id="payment_provider_wechatpay">
            <field name="name">WeChat Pay</field>
            <field name="code">wechatpay</field>
            <field name="redirect_form_view_id" ref="redirect_form"/>
            <field name="image_128" type="bytes" file="qing_payment_wechatpay/static/images/wechatpay.png"/>
            <field name="module_id" ref="base.module_qing_payment_wechatpay"/>
        </record>

        <record model="payment.method" id="payment_method_wechatpay">
            <field name="name">WeChat Pay</field>
            <field name="code">wechatpay</field>
            <field name="active">True</field>
            <field name="provider_id" ref="payment_provider_wechatpay"/>
            <field name="image" type="bytes" file="qing_payment_wechatpay/static/images/wechatpay.png"/>
            <field name="support_refund">partial</field>
            <field name="supported_currency_ids" eval="[Command.set([ref('base.CNY')])]"/>
        </record>

    </data>
</odoo>
