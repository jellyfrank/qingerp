<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_qing_ai_sale_tool_list" model="ir.ui.view">
        <field name="name">qing.ai.sale.tool.list</field>
        <field name="model">qing.ai.sale.tool</field>
        <field name="arch" type="xml">
            <list string="AI Sales Tool Permissions" create="0" delete="0">
                <field name="name"/><field name="key"/><field name="allowed_group_ids" widget="many2many_tags"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_qing_ai_sale_tool_form" model="ir.ui.view">
        <field name="name">qing.ai.sale.tool.form</field>
        <field name="model">qing.ai.sale.tool</field>
        <field name="arch" type="xml">
            <form string="AI Sales Tool Permission" create="0" delete="0">
                <sheet><group>
                    <field name="name"/><field name="key"/><field name="active"/>
                    <field name="allowed_group_ids" widget="many2many_tags"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_qing_ai_sale_tool" model="ir.actions.act_window">
        <field name="name">Sales Tool Permissions</field>
        <field name="res_model">qing.ai.sale.tool</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_qing_ai_sale_tool" name="Sales Tool Permissions"
              parent="qing_ai.menu_qing_ai_root" action="action_qing_ai_sale_tool"
              sequence="80" groups="base.group_system" active="False"/>
</odoo>
