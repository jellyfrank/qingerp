<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_aliyun_picking_form" model="ir.ui.view">
            <field name="name">stock picking form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_cancel']" position="after">
                    <button name="action_qing_send_sms" type="object" string="发送短信" groups="qing_sms.group_sms_user" class="oe_highlight"/>
                </xpath>
                <xpath expr="//sheet//field[@name='partner_id'][1]" position="after">
                    <field name="qing_sms_status" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
