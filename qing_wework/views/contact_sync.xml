<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wework_contact_sync_job_list" model="ir.ui.view">
            <field name="name">wework.contact.sync.job.list</field>
            <field name="model">wework.contact.sync.job</field>
            <field name="arch" type="xml">
                <list create="false" delete="false">
                    <field name="job_type"/>
                    <field name="company_id" optional="hide"/>
                    <field name="wework_id"/>
                    <field name="department_binding_id" optional="hide"/>
                    <field name="binding_id" optional="hide"/>
                    <field name="department_id" optional="hide"/>
                    <field name="state"/>
                    <field name="attempts"/>
                    <field name="next_run"/>
                    <field name="started_at" optional="hide"/>
                    <field name="finished_at" optional="hide"/>
                    <field name="last_error" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_wework_contact_sync_job_form" model="ir.ui.view">
            <field name="name">wework.contact.sync.job.form</field>
            <field name="model">wework.contact.sync.job</field>
            <field name="arch" type="xml">
                <form create="false" delete="false">
                    <header>
                        <button name="action_process" string="Process Now" type="object" class="oe_highlight" invisible="state not in ['pending', 'waiting_department', 'retry']"/>
                        <button name="action_retry" string="Retry" type="object" invisible="state not in ['failed', 'conflict']"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['pending', 'waiting_department', 'retry']"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,waiting_department,running,done,retry,conflict,failed,cancelled"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="job_type"/>
                                <field name="company_id"/>
                                <field name="wework_id"/>
                                <field name="department_binding_id" invisible="job_type != 'department'"/>
                                <field name="binding_id" invisible="job_type != 'user'"/>
                                <field name="department_id" invisible="job_type != 'user_pull'"/>
                            </group>
                            <group>
                                <field name="attempts"/>
                                <field name="next_run"/>
                                <field name="requested_by_id"/>
                                <field name="started_at"/>
                                <field name="finished_at"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payload">
                                <field name="payload" nolabel="1"/>
                            </page>
                            <page string="Error">
                                <field name="last_error" nolabel="1"/>
                            </page>
                            <page string="Result">
                                <field name="result_summary" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_wework_contact_sync_job" model="ir.actions.act_window">
            <field name="name">Contact Sync Jobs</field>
            <field name="res_model">wework.contact.sync.job</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_wework_contact_sync_job" name="Contact Sync Jobs" parent="menu_wework_config" action="action_wework_contact_sync_job" groups="group_wework_manager" sequence="17" active="False"/>
    </data>
</odoo>
