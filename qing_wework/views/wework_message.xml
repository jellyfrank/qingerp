<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wework_message_form" model="ir.ui.view">
            <field name="name">wework message form</field>
            <field name="model">wework.message</field>
            <field name="arch" type="xml">
                <form string="" class="">
                    <header>
                        <button name="send" string="Send" type="object" class="oe_highlight" invisible="state == 'success'"/>
                        <button name="reset" string="Reset" type="object" class="oe_highlight" invisible="state == 'draft'"/>
                        <field name="state" string="State" class="oe_highlight" type="object" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Receivers">
                                <field name="to_all"/>
                                <field name="department_ids" domain="[('wework_department_id','!=',False)]" widget="many2many_tags" invisible="to_all"/>
                                <field name="employee_ids" domain="[('department_id','in',department_ids)]" widget="many2many_tags" invisible="to_all"/>
                                <field name="from_user"/>
                                <field name="to_user"/>
                                <field name="company_id" required="1"/>
                                <field name="res_model"/>
                                <field name="res_id"/>
                            </group>
                            <group string="Message">
                                <field name="msg_type"/>
                                <field name="media_id" domain="[('media_type','=', msg_type)]" invisible="msg_type in ['text']"/>
                                <field name="content" invisible="media_id"/>
                                <field name="title" invisible="msg_type != 'card'"/>
                                <field name="need_authorized"/>
                                <field name="url" invisible="msg_type != 'card'"/>
                                <field name="button_text" invisible="msg_type != 'card'"/>
                                <field name="description" invisible="msg_type != 'card'"/>
                                <field name="articles" widget="many2many_tags" invisible="msg_type not in ['mp','mpnews']"/>
                            </group>
                        </group>
                        <field name="error_message" invisible="state != 'fail'"/>
                    </sheet>
                    <chatter />

                </form>
            </field>
        </record>

        <record id="view_wework_message_list" model="ir.ui.view">
            <field name="name">wework message list</field>
            <field name="model">wework.message</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="department_ids" widget="many2many_tags" />
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="to_all"/>
                    <field name="msg_type"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="action_wework_message" model="ir.actions.act_window">
            <field name="name">WeWork Message</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wework.message</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_qing_wework_message" name="Message" parent="menu_qing_wework_root" action="action_wework_message"/>
        <menuitem id="menu_qing_wework_messages" name="Messages" parent="menu_qing_wework_message" action="action_wework_message"/>

        <!--Article-->
        <record id="view_wework_article" model="ir.ui.view">
            <field name="name">Article</field>
            <field name="model">wework.article</field>
            <field name="arch" type="xml">
                <form string="" class="">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="" class="oe_edit_only"/>
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="author" invisible="type != 'mpnews'"/>
                                <field name='content_source_url' invisible="type != 'mpnews'"/>
                                <field name="thumb_media_id" invisible="type != 'mpnews'"/>
                            </group>
                            <group>
                                <field name="url" invisible="type != 'news'"/>
                                <field name="pic_url" invisible="type != 'news'"/>
                                <field name="appid" invisible="type != 'news'"/>
                                <field name="page_path" invisible="type != 'news'"/>
                            </group>
                            <!-- <div>
                                <label for="digest" string="Description"/>
                                <field name="digest"/>
                            </div>
                            <div invisible="type != 'mpnews'">
                                <label for="content" string="Content"/>
                                <field name="content"/>
                            </div> -->
                            <group>
                                <field name="digest"/>
                                <field name="content" invisible="type != 'mpnews'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_wework_article_list" model="ir.ui.view">
            <field name="name">wework article list</field>
            <field name="model">wework.article</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <list string="">
                    <field name="name"/>
                    <field name="author"/>
                    <field name="url"/>
                    <field name="pic_url"/>
                    <field name="digest"/>
                </list>
            </field>
        </record>

        <record id="action_wework_article" model="ir.actions.act_window">
            <field name="name">Article</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wework.article</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_wework_article" name="Article" parent="menu_qing_wework_message" action="action_wework_article"/>
    </data>
</odoo>