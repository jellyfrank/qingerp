<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wework_confirm_wizard_form" model="ir.ui.view">
        <field name="name">wework.confirm.wizard.form</field>
        <field name="model">wework.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm">
                <field name="content" nolabel="1"/>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
