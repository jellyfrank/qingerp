<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wework_connect_wizard" model="ir.ui.view">
            <field name="name">WeWrok Connect Wizard</field>
            <field name="model">wework.connect.wizard</field>
            <field name="arch" type="xml">
                <form string="">
                    <h1>Connect Wizard</h1>
                    <div>
                        <group>
                            <field name="policy"/>
                        </group>
                    </div>
                    <footer>
                        <button name="button_confirm" string="Confirm" class="oe_highlight" type="object" />
                        or
                        <button special="cancel" string="Cancel" class="oe_link" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wework_connect_wizard" model="ir.actions.act_window">
            <field name="name">Connect Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wework.connect.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_wework_connect" name="Connect" parent="menu_wework_config" action="action_wework_connect_wizard" sequence="5"/>
    </data>
</odoo>