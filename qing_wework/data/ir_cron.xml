<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_wework_intelligent_bot_websocket" model="ir.cron">
            <field name="name">WeCom Intelligent Bot: Ensure WebSocket Connections</field>
            <field name="model_id" ref="model_wework_intelligent_bot"/>
            <field name="state">code</field>
            <field name="code">model.cron_ensure_websocket_connections()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_wework_contact_sync" model="ir.cron">
            <field name="name">WeWork: Synchronize Organization and Users</field>
            <field name="model_id" ref="model_wework_contact_sync_job"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_wework_robot_schedule" model="ir.cron">
            <field name="name">WeWork Robot: Run Schedules</field>
            <field name="model_id" ref="model_wework_robot_schedule"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_due_schedules()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_wework_intelligent_bot_media_message" model="ir.cron">
            <field name="name">WeWork Intelligent Bot: Send File Links</field>
            <field name="model_id" ref="model_wework_intelligent_bot_media_message"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_messages()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
