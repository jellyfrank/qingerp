<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.cron" id="cron_sync_wework_departments">
            <field name="name">Sync Wework Departments</field>
            <field name="model_id" ref="model_hr_department"/>
            <field name="state">code</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="priority">1</field>
            <field name="code">model._sync_departments()</field>
        </record>

        <record model="auth.oauth.provider" id="oauth_provider_wework">
            <field name="name">Wework OAuth Provider</field>
            <field name="body">Login with Wework</field>
            <field name="auth_endpoint">https://open.work.weixin.qq.com/wwopen/sso/qrConnect</field>
            <field name="validation_endpoint">https://qyapi.weixin.qq.com/cgi-bin/auth/getuserinfo</field>
        </record>

    </data>
</odoo>