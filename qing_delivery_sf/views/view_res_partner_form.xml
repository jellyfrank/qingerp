<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">qing.delivery.sf.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='container_row_2']" position="inside">
                <group name="sf_express" string="SF Express" groups="stock.group_stock_manager">
                    <field name="sf_monthly_card"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
