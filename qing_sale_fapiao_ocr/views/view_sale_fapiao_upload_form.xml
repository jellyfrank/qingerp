<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_sale_fapiao_upload_form" model="ir.ui.view">
        <field name="name">qing.fapiao.ocr.form.sale.upload</field>
        <field name="model">qing.fapiao.ocr</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Upload Issued Tax Invoice">
                <div class="alert alert-info" role="status">Upload one issued blue tax invoice (single-page PDF, PNG, or JPEG; up to 10 MB). Review the recognized fields against the original file before creating the customer invoice.</div>
                <field name="recognized" invisible="1"/>
                <field name="fapiao_id" invisible="1"/>
                <field name="available_sale_invoice_ids" invisible="1"/>
                <field name="direction" invisible="1"/>
                <field name="color" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id" readonly="1" options="{'no_create': True}"/>
                        <field name="partner_id" string="Customer" readonly="1" options="{'no_create': True}"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="source_file" filename="source_filename" readonly="fapiao_id"/>
                        <field name="source_filename" invisible="1"/>
                        <field name="sale_invoice_id" string="Existing Customer Invoice" domain="[('id', 'in', available_sale_invoice_ids)]" options="{'no_create': True, 'no_create_edit': True}" readonly="fapiao_id"/>
                        <div class="text-muted" colspan="2">Leave empty to reuse a matching invoice or invoice all remaining invoiceable sales order lines. For a partial tax invoice, select its existing customer invoice.</div>
                        <field name="deduct_down_payments" invisible="sale_invoice_id" readonly="fapiao_id"/>
                    </group>
                </group>
                <group string="Review Tax Invoice" invisible="not recognized">
                    <group>
                        <field name="kind" readonly="fapiao_id"/>
                        <field name="number" readonly="fapiao_id"/>
                        <field name="code" readonly="fapiao_id"/>
                        <field name="invoice_date" readonly="fapiao_id"/>
                        <field name="amount_untaxed" readonly="fapiao_id"/>
                        <field name="amount_tax" readonly="fapiao_id"/>
                        <field name="invoice_total" readonly="fapiao_id"/>
                    </group>
                    <group>
                        <field name="buyer_name" readonly="fapiao_id"/>
                        <field name="buyer_tax_id" readonly="fapiao_id"/>
                        <field name="seller_name" readonly="fapiao_id"/>
                        <field name="seller_tax_id" readonly="fapiao_id"/>
                    </group>
                </group>
                <group invisible="not recognized">
                    <field name="ocr_engine" readonly="1"/>
                    <field name="ocr_text" readonly="1"/>
                    <field name="reviewed" readonly="fapiao_id"/>
                </group>
                <footer>
                    <button name="action_recognize" string="Recognize / Recognize Again" type="object" class="btn-secondary" invisible="fapiao_id"/>
                    <button name="action_create_draft" string="Create / Link Customer Invoice" type="object" class="btn-primary" invisible="not recognized or fapiao_id"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
