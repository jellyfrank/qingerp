<odoo>
  <record id="view_compose_form" model="ir.ui.view">
    <field name="name">qing.whatsapp.compose.form.sale</field><field name="model">qing.whatsapp.compose</field>
    <field name="inherit_id" ref="qing_whatsapp.view_qing_whatsapp_compose_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group" position="before"><group invisible="not sale_order_id"><field name="sale_order_id"/><button name="action_refresh_sale_preview" type="object" string="Refresh quotation PDF and variables"/></group></xpath>
      <xpath expr="//field[@name='number']" position="attributes"><attribute name="readonly">sale_order_id</attribute></xpath>
      <xpath expr="//field[@name='partner_id']" position="attributes"><attribute name="readonly">sale_order_id</attribute></xpath>
      <xpath expr="//field[@name='upload_data']" position="attributes"><attribute name="invisible">sale_order_id or kind not in ['template','image','document','audio','video']</attribute></xpath>
      <xpath expr="//field[@name='attachment_id']" position="attributes"><attribute name="readonly">sale_order_id</attribute></xpath>
    </field>
  </record>
</odoo>
