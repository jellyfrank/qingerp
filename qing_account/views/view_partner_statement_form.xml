<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_statement_form" model="ir.ui.view">
        <field name="name">qing.partner.statement.form</field>
        <field name="model">qing.partner.statement</field>
        <field name="arch" type="xml">
            <form string="客商对账与账龄">
                <group>
                    <field name="company_id"/>
                    <field name="account_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <div class="alert alert-info" role="status">仅统计当前公司已过账应收应付科目，包含期初、收付款、贷项及其他往来分录。
                    预收预付专用的非应收应付科目暂不纳入；本功能只读，不执行核销。
                    留空往来单位查询全部，指定时按所选联系人精确筛选。</div>
                <field name="result" nolabel="1" invisible="not result"/>
                <group invisible="not result_file">
                    <field name="result_file" filename="result_filename"/>
                    <field name="result_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="生成对账" class="btn-primary"/>
                    <button name="action_save_snapshot" type="object" string="重新生成并保存快照" class="btn-secondary"/>
                    <button name="action_open_lines" type="object" string="查看范围分录" class="btn-secondary"/>
                    <button special="cancel" string="关闭" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_partner_statement" model="ir.actions.act_window">
        <field name="name">客商对账与账龄</field>
        <field name="res_model">qing.partner.statement</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_partner_statement" name="客商对账与账龄" parent="account.menu_finance_entries"
              action="action_partner_statement" sequence="90" groups="account.group_account_manager"/>
</odoo>
