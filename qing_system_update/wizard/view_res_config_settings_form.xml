<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">qing.system.update.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='about_setting_container']" position="before">
                <block title="QingERP Version" name="qing_system_update">
                    <setting id="qing_system_update" string="QingERP Version"
                             help="Updates are not yet available. When enabled, updates will stop the service and will not back up attachments.">
                        <div class="d-flex flex-column gap-1 mt-2">
                            <div>
                                <span class="text-muted me-2">Installed Version</span>
                                <field name="qing_update_current_version" class="oe_inline fw-bold"/>
                                <span class="text-muted ms-3 me-2" invisible="not qing_update_latest_version">Latest Version</span>
                                <field name="qing_update_latest_version" class="oe_inline fw-bold"
                                       invisible="not qing_update_latest_version"/>
                            </div>
                            <field name="qing_update_state" widget="badge"
                                   decoration-success="qing_update_state == 'up_to_date'"
                                   decoration-info="qing_update_state in ('available', 'requested', 'running')"
                                   decoration-danger="qing_update_state == 'failed'"
                                   decoration-muted="qing_update_state in ('unsupported', 'unknown')"/>
                            <field name="qing_update_message" class="text-muted"
                                   invisible="not qing_update_message"/>
                            <div class="d-flex gap-2 mt-1" invisible="qing_update_state == 'unsupported'">
                                <button name="action_qing_update_request" type="object" class="btn-primary"
                                        icon="cloud_download" string="Upgrade Now"
                                        invisible="True"
                                        confirm="Upgrade QingERP now? The service will stop during the update. Attachments are not backed up."/>
                                <button name="action_qing_update_check" type="object" class="btn-secondary"
                                        icon="refresh" string="Check for Updates"
                                        invisible="qing_update_state in ('requested', 'running')"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
