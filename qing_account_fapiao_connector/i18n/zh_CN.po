#. module: qing_account_fapiao_connector
#. odoo-python
#: code:addons/qing_account_fapiao_connector/models/fapiao_request.py:0
msgid ""
"Record this invoice from its provider task. An issued task must not be "
"submitted for invoicing again."
msgstr "请从关联的开票任务登记税票。已经开票的任务不能再次提交开票。"

#. module: qing_account_fapiao_connector
#. odoo-python
#: code:addons/qing_account_fapiao_connector/models/fapiao_request.py:0
