#. module: qing_account_fapiao_connector
#. odoo-python
#: code:addons/qing_account_fapiao_connector/models/fapiao_request.py:0
msgid ""
"Provider invoicing currently supports normal and special blue VAT invoices "
"only."
msgstr "接口开票目前仅支持增值税普通发票和专用发票的蓝字开票。"

#. module: qing_account_fapiao_connector
#. odoo-python
#: code:addons/qing_account_fapiao_connector/models/fapiao_request_line.py:0
msgid ""
"Provider invoicing currently supports one standard percentage sales tax per "
"line. Use manual recording for other tax configurations."
msgstr "接口开票目前要求每行使用一项标准百分比销项税；其他税项配置请使用人工回填。"

#. module: qing_account_fapiao_connector
#. odoo-python
#: code:addons/qing_account_fapiao_connector/models/fapiao_request.py:0
#: code:addons/qing_account_fapiao_connector/models/qing_fapiao_order.py:0
msgid "Provider task links are managed by invoicing actions."
msgstr "开票任务关联由系统操作维护，不能直接修改。"

#. module: qing_account_fapiao_connector
#: model:ir.module.module,shortdesc:base.module_qing_account_fapiao_connector
