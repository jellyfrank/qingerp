<odoo>
    <record id="view_repair_purchase_wizard_form" model="ir.ui.view">
        <field name="name">qing.repair.purchase.wizard.form</field>
        <field name="model">qing.repair.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Repair Purchase">
                <group>
                    <field name="repair_id"/>
                    <field name="supplier_id" required="1"/>
                    <field name="currency_id"/>
                    <field name="date_order"/>
                    <field name="date_planned"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="price_unit"/>
                        <field name="discount" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_purchase" type="object" string="Create Purchase" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
