<odoo>
    <record id="view_purchase_wizard_form" model="ir.ui.view">
        <field name="name">qing.sale.purchase.wizard.form</field>
        <field name="model">qing.sale.purchase.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Purchase">
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="sale_order_id"/>
                        <field name="supplier_id"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="currency_id"/>
                        <field name="date_order"/>
                        <field name="date_planned"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Unarranged quantities do not deduct available stock. Existing draft RFQs count as arranged.
                    Automatic procurement lines must use their existing supply workflow.
                </div>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="company_id" column_invisible="True"/>
                        <field name="sale_line_id" column_invisible="True"/>
                        <field name="selected"/>
                        <field name="product_id"/>
                        <field name="sale_qty" optional="hide"/>
                        <field name="sale_uom_id" optional="hide"/>
                        <field name="arranged_qty"/>
                        <field name="remaining_qty"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                        <field name="supplier_id"/>
                        <field name="currency_id"/>
                        <field name="price_unit"/>
                        <field name="discount" optional="hide"/>
                        <field name="overage_reason" optional="hide" groups="purchase.group_purchase_manager"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_purchase" type="object" string="Create RFQs" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
