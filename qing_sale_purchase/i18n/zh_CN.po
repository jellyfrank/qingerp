msgstr "未安排量不扣减现有库存，草稿询价单也计入已安排量。自动采购明细须沿用原供货流程。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/wizard/purchase_wizard.py:0
msgid "Set the order date and expected arrival date."
msgstr "请填写采购日期和预计到货日期。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/wizard/purchase_wizard.py:0
msgid "Choose an active buyer with purchase access."
msgstr "请选择有效且具有采购权限的采购员。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/wizard/purchase_wizard_line.py:0
msgid "The purchase currency must be active."
msgstr "采购币种必须处于启用状态。"

#. module: qing_sale_purchase
#: model:ir.model.fields,field_description:qing_sale_purchase.field_qing_sale_purchase_wizard__sale_order_id
