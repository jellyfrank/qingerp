msgstr "仅支持已确认销售订单上数量为正且允许采购的商品行。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order_line.py:0
msgid "This sales line uses automatic procurement. Use its existing supply workflow: %s"
msgstr "该销售行使用自动采购，请沿用已有供货流程：%s"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order_line.py:0
msgid "An automatic supply chain already exists for %s."
msgstr "%s 已存在自动供货链，请勿重复手工采购。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order_line.py:0
