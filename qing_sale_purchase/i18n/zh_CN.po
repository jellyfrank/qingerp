msgstr "每条来源明细必须属于当前销售订单，且只能出现一次。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/wizard/purchase_wizard.py:0
msgid "The buyer must have access to the sales company."
msgstr "采购员必须有权访问销售订单所属公司。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order.py:0
#: model_terms:ir.ui.view,arch_db:qing_sale_purchase.view_sale_order_form
#: model_terms:ir.ui.view,arch_db:qing_sale_purchase.view_purchase_wizard_form
msgid "Create Purchase"
msgstr "创建采购"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order.py:0
msgid "There are no purchasable goods on this order."
msgstr "本订单没有可采购的商品。"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order.py:0
msgid "Review sales purchase changes"
msgstr "检查销售采购变更"

#. module: qing_sale_purchase
#: code:addons/qing_sale_purchase/models/sale_order.py:0
msgid "The source sales order was cancelled or its quantity fell below the arranged purchase quantity. Review this purchase manually."
msgstr "来源销售订单已取消，或销售数量少于已安排采购量，请人工检查本采购单。"

#. module: qing_sale_purchase
#: model:ir.model.fields,field_description:qing_sale_purchase.field_purchase_order_line__qing_manual_purchase
