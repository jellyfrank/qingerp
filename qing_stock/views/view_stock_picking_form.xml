<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_product_link" model="ir.ui.view">
        <field name="name">qing.stock.picking.form.product.link</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/column/field[@name='product_id']" position="attributes">
                <attribute name="widget">qing_stock_move_product_link</attribute>
            </xpath>
        </field>
    </record>
</odoo>
