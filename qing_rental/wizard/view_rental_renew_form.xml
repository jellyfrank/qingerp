<odoo>
    <record id="view_rental_renew_form" model="ir.ui.view">
        <field name="name">qing.rental.renew.form</field>
        <field name="model">qing.rental.renew</field>
        <field name="arch" type="xml">
            <form string="Renew Rental">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="new_end"/>
                    <field name="charge_amount"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Confirm Renewal" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
