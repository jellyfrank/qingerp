<odoo>
    <record id="privilege_rental" model="res.groups.privilege">
        <field name="name">Rental</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_rental_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_rental"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_rental_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_rental"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('group_rental_user')), Command.link(ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin')), Command.link(ref('base.user_root'))]"/>
    </record>
</odoo>
