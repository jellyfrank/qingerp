<odoo>
    <record id="view_rental_deposit_form" model="ir.ui.view">
        <field name="name">qing.rental.deposit.form</field>
        <field name="model">qing.rental.deposit</field>
        <field name="arch" type="xml">
            <form string="Rental Deposit">
                <header>
                    <button name="action_post" type="object" string="Post Deposit" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_invoice"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="order_id" readonly="id" options="{'no_create': True}"/>
                            <field name="kind" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="journal_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="liability_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="move_id" string="Journal Entry" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" readonly="state != 'draft'" placeholder="Deposit receipt or refund notes..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_rental_deposit_list" model="ir.ui.view">
        <field name="name">qing.rental.deposit.list</field>
        <field name="model">qing.rental.deposit</field>
        <field name="arch" type="xml">
            <list string="Rental Deposits">
                <field name="date"/>
                <field name="order_id"/>
                <field name="kind"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="journal_id"/>
                <field name="move_id" string="Journal Entry"/>
                <field name="reference" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_rental_deposits" model="ir.actions.act_window">
        <field name="name">Rental Deposits</field>
        <field name="res_model">qing.rental.deposit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
