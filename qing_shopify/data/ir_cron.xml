<odoo noupdate="1">
    <record id="cron_shopify_renew_credentials" model="ir.cron">
        <field name="name">Shopify: Renew access tokens</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_renew_credentials()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_pull" model="ir.cron">
        <field name="name">Shopify: Reconcile orders</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_pull()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_recover_product_mappings" model="ir.cron">
        <field name="name">Shopify: Recover order product mappings</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_recover_product_mappings()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_bulk_import" model="ir.cron">
        <field name="name">Shopify: Process bulk order history</field>
        <field name="model_id" ref="model_qing_shopify_bulk_import"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_bulk_import()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_purge_customer_data" model="ir.cron">
        <field name="name">Shopify: Remove expired customer payloads</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_purge_customer_data()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_shopify_inventory" model="ir.cron">
        <field name="name">Shopify: Publish inventory</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_inventory()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_catalog" model="ir.cron">
        <field name="name">Shopify: Read and Import Catalog</field>
        <field name="model_id" ref="model_qing_shopify_catalog_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_catalog()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="cron_shopify_catalog_reconcile" model="ir.cron">
        <field name="name">Shopify: Reconcile Product Catalog</field>
        <field name="model_id" ref="qing_channel.model_qing_channel_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_catalog_reconcile()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
