<odoo>
    <record id="view_shopify_catalog_item_list" model="ir.ui.view">
        <field name="name">qing.shopify.catalog.item.list</field>
        <field name="model">qing.shopify.catalog.item</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="store_id"/>
                <field name="variant_count"/>
                <field name="shop_price"/>
                <field name="remote_status"/>
                <field name="state" widget="badge" decoration-success="state == 'linked'" decoration-warning="state == 'review'"/>
                <field name="issue" optional="show"/>
                <field name="last_synced_at" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_shopify_catalog_item_form" model="ir.ui.view">
        <field name="name">qing.shopify.catalog.item.form</field>
        <field name="model">qing.shopify.catalog.item</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_catalog_recheck" type="object" string="Recheck"
                            groups="qing_channel.group_channel_manager" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="link,linked" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="remote_status" string="Shopify Product Status" invisible="not remote_status"/>
                        </group>
                        <group>
                            <field name="last_synced_at" string="Last Synced At" invisible="not last_synced_at"/>
                            <field name="issue" invisible="not issue"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="variants" string="Variants">
                            <group>
                                <field name="variant_count"/>
                            </group>
                            <field name="variant_preview" nolabel="1" invisible="not variant_preview"/>
                        </page>
                        <page name="product_details" string="Product Details">
                            <group name="product_details_summary">
                                <group name="product_identity_details">
                                    <field name="shop_price"/>
                                    <field name="external_id" string="Shopify Product ID" invisible="not external_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_shopify_catalog_item_search" model="ir.ui.view">
        <field name="name">qing.shopify.catalog.item.search</field>
        <field name="model">qing.shopify.catalog.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="store_id"/>
                <filter name="needs_review" string="Needs Review" domain="[('state', '=', 'review')]"/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
            </search>
        </field>
    </record>
    <record id="action_shopify_catalog_items" model="ir.actions.act_window">
        <field name="name">Channel Products</field>
        <field name="res_model">qing.shopify.catalog.item</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_shopify_channel_products" name="Channel Products"
              action="action_shopify_catalog_items" parent="qing_channel.menu_channels_root"
              groups="qing_channel.group_channel_user" sequence="22"/>
    <record id="view_shopify_catalog_run_form" model="ir.ui.view">
        <field name="name">qing.shopify.catalog.run.form</field>
        <field name="model">qing.shopify.catalog.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_catalog_confirm" type="object" string="Confirm Catalog Import"
                            class="oe_highlight" invisible="state != 'preview'"/>
                    <button name="action_catalog_retry" type="object" string="Retry" invisible="state != 'review'"/>
                    <button name="action_catalog_cancel" type="object" string="Close Preview" invisible="state not in ('preview', 'review')"/>
                    <field name="state" widget="badge"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="store_id"/></h1></div>
                    <group>
                        <group>
                            <field name="new_count"/>
                            <field name="link_count"/>
                            <field name="linked_count"/>
                            <field name="different_count"/>
                        </group>
                        <group>
                            <field name="review_count"/>
                            <field name="archived_count"/>
                            <field name="skipped_count"/>
                            <field name="issue" invisible="not issue"/>
                        </group>
                    </group>
                    <group string="New Product Defaults" invisible="state != 'preview' or not product_defaults_preview">
                        <field name="product_defaults_preview" nolabel="1" colspan="2"/>
                    </group>
                    <field name="item_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name"/>
                            <field name="variant_count"/>
                            <field name="remote_status"/>
                            <field name="state" widget="badge"/>
                            <field name="issue"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_shopify_store_catalog_form" model="ir.ui.view">
        <field name="name">qing.channel.store.shopify.catalog.form</field>
        <field name="model">qing.channel.store</field>
        <field name="inherit_id" ref="qing_channel.view_channel_store_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Shopify Catalog Import" invisible="platform != 'shopify'" groups="qing_channel.group_channel_manager">
                    <field name="shopify_catalog_category_id"/>
                    <field name="shopify_catalog_purchase_ok"/>
                    <button name="action_shopify_preview_catalog" type="object" string="Preview Store Products" class="btn-secondary"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
