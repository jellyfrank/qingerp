<odoo>
    <record id="view_shopify_bulk_import_list" model="ir.ui.view">
        <field name="name">qing.shopify.bulk.import.list</field>
        <field name="model">qing.shopify.bulk.import</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="store_id"/>
                <field name="window_from"/>
                <field name="window_to"/>
                <field name="state" widget="badge" decoration-danger="state == 'review'" decoration-success="state == 'done'"/>
                <field name="queued_orders"/>
                <field name="expected_orders"/>
                <field name="last_issue"/>
                <button name="action_recheck" type="object" string="Recheck" invisible="state != 'review'"/>
            </list>
        </field>
    </record>
    <record id="action_shopify_bulk_import" model="ir.actions.act_window">
        <field name="name">Shopify Bulk History</field>
        <field name="res_model">qing.shopify.bulk.import</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_shopify_bulk_import_list"/>
    </record>
    <menuitem id="menu_shopify_bulk_import" name="Import Order History" parent="qing_channel.menu_channel_configuration"
              action="action_shopify_bulk_import" groups="qing_channel.group_channel_manager" sequence="50"/>
</odoo>
