<odoo>
    <record id="view_opening_commitment_list" model="ir.ui.view">
        <field name="name">qing.shopify.opening.commitment.list</field>
        <field name="model">qing.shopify.opening.commitment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="store_id" domain="[('platform', '=', 'shopify')]"/>
                <field name="external_order"/>
                <field name="external_line_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="sale_line_id"/>
            </list>
        </field>
    </record>
    <record id="action_opening_commitment" model="ir.actions.act_window">
        <field name="name">Shopify Opening Commitments</field>
        <field name="res_model">qing.shopify.opening.commitment</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_opening_commitment" name="Opening Commitments"
              parent="qing_channel.menu_channel_configuration" action="action_opening_commitment"
              groups="qing_channel.group_channel_manager" sequence="40"/>
</odoo>
