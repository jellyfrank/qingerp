<odoo>
    <record id="view_knowledge_space_list" model="ir.ui.view">
        <field name="name">qing.knowledge.space.list</field>
        <field name="model">qing.knowledge.space</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="publication_policy"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_knowledge_space_form" model="ir.ui.view">
        <field name="name">qing.knowledge.space.form</field>
        <field name="model">qing.knowledge.space</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_member" type="object" string="Set Member"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="id"/>
                        <field name="active"/>
                        <field name="publication_policy"/>
                        <field name="uuid" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="members" string="Members">
                            <field name="member_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_knowledge_spaces" model="ir.actions.act_window">
        <field name="name">Knowledge Spaces</field>
        <field name="res_model">qing.knowledge.space</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
