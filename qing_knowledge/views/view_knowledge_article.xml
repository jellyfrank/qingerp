<odoo>
    <record id="view_knowledge_article_list" model="ir.ui.view">
        <field name="name">qing.knowledge.article.list</field>
        <field name="model">qing.knowledge.article</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="space_id"/>
                <field name="lifecycle"/>
                <field name="owner_id"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>
    <record id="view_knowledge_article_form" model="ir.ui.view">
        <field name="name">qing.knowledge.article.form</field>
        <field name="model">qing.knowledge.article</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="open_draft" type="object" string="Open My Draft"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="space_id"/>
                        <field name="lifecycle"/>
                        <field name="uuid"/>
                        <field name="parent_id"/>
                    </group>
                    <notebook>
                        <page name="published" string="Published">
                            <field name="published_revision_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_knowledge_articles" model="ir.actions.act_window">
        <field name="name">Knowledge Articles</field>
        <field name="res_model">qing.knowledge.article</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
