<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_flow_allocation_list" model="ir.ui.view">
        <field name="name">qing.cash.flow.allocation.list</field>
        <field name="model">qing.cash.flow.allocation</field>
        <field name="arch" type="xml">
            <list string="Cash Flow Classification">
                <field name="cash_line_id"/>
                <field name="line_code"/>
                <field name="amount"/>
                <field name="note"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_cash_flow_allocation_form" model="ir.ui.view">
        <field name="name">qing.cash.flow.allocation.form</field>
        <field name="model">qing.cash.flow.allocation</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Classification">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="cash_line_id" domain="[('company_id', '=', company_id), ('parent_state', '=', 'posted')]"/>
                        <field name="line_code"/>
                        <field name="amount"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cash_flow_allocation" model="ir.actions.act_window">
        <field name="name">Cash Flow Classification</field>
        <field name="res_model">qing.cash.flow.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_cash_flow_workspace" model="ir.actions.client">
        <field name="name">Chinese Small Business Cash Flow Statement</field>
        <field name="tag">qing_account_reports.financial_report</field>
        <field name="params" eval="{'report_type': 'cash'}"/>
    </record>
    <menuitem id="menu_cash_flow" name="Chinese Small Business Cash Flow Statement" parent="account.menu_finance_reports" action="action_cash_flow_workspace" groups="account.group_account_manager" sequence="16"/>
    <menuitem id="menu_cash_flow_allocation" name="Cash Flow Classification" parent="menu_financial_report_configuration" action="action_cash_flow_allocation" groups="account.group_account_manager" sequence="4"/>
</odoo>
