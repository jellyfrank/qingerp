<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_balance_sheet_form" model="ir.ui.view">
        <field name="name">qing.balance.sheet.form</field><field name="model">qing.balance.sheet</field>
        <field name="arch" type="xml">
            <form string="Chinese Small Business Balance Sheet">
                <header><button name="action_generate" type="object" string="Generate" class="btn-primary"/></header>
                <sheet>
                    <group><group><field name="company_id"/><field name="date_to"/></group><group><field name="currency_id"/><field name="mapping_id" options="{'no_create': True}"/></group></group>
                    <div class="alert alert-info" role="status">Posted entries in company currency. Opening balances are reconstructed at December 31 of the previous year using this mapping; they are not a frozen prior-year filing. Map unclosed earnings to row 51. Review maturity reclassifications using separate accounts and mappings. This report does not close earnings or post adjustments.</div>
                    <field name="result" nolabel="1" invisible="not result"/>
                    <group invisible="not result_file"><field name="result_file" filename="result_filename"/><field name="result_filename" invisible="1"/></group>
                    <group string="Source Entries"><field name="source_account_id" context="{'active_test': False}" options="{'no_create': True}"/><button name="action_open_lines" type="object" string="View Source Entries" class="btn-secondary"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_balance_sheet" model="ir.actions.act_window">
        <field name="name">Chinese Small Business Balance Sheet</field><field name="res_model">qing.balance.sheet</field><field name="view_mode">form</field>
    </record>
    <record id="action_balance_sheet_workspace" model="ir.actions.client">
        <field name="name">Chinese Small Business Balance Sheet</field>
        <field name="tag">qing_account_reports.financial_report</field>
        <field name="params" eval="{'report_type': 'balance'}"/>
    </record>
    <menuitem id="menu_balance_sheet" name="Chinese Small Business Balance Sheet" parent="account.menu_finance_reports" action="action_balance_sheet_workspace" groups="account.group_account_manager" sequence="12"/>
</odoo>
