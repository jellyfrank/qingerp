<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trial_balance_form" model="ir.ui.view">
        <field name="name">qing.trial.balance.form</field>
        <field name="model">qing.trial.balance</field>
        <field name="arch" type="xml">
            <form string="Account Balances and Trial Balance">
                <group>
                    <field name="company_id"/>
                    <field name="currency_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <div class="alert alert-info" role="status">Posted entries only, in company currency. Opening balances include all entries before the start date; no automatic year-end earnings transfer is applied. Differences are based on records you can access and do not constitute financial approval.</div>
                <field name="result" nolabel="1" invisible="not result"/>
                <group invisible="not result_file">
                    <field name="result_file" filename="result_filename"/>
                    <field name="result_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button name="action_open_lines" type="object" string="View Source Entries" class="btn-secondary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_trial_balance" model="ir.actions.act_window">
        <field name="name">Account Balances and Trial Balance</field>
        <field name="res_model">qing.trial.balance</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_trial_balance_workspace" model="ir.actions.client">
        <field name="name">Account Balances and Trial Balance</field>
        <field name="tag">qing_account_reports.financial_report</field>
        <field name="params" eval="{'report_type': 'trial_balance'}"/>
    </record>
    <menuitem id="menu_trial_balance" name="Account Balances and Trial Balance"
              parent="account.menu_finance_reports" action="action_trial_balance_workspace"
              groups="account.group_account_manager" sequence="10"/>
</odoo>
