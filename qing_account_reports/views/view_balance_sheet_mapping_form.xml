<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_balance_sheet_mapping_list" model="ir.ui.view">
        <field name="name">qing.balance.sheet.mapping.list</field>
        <field name="model">qing.balance.sheet.mapping</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="template_version"/><field name="state"/></list></field>
    </record>
    <record id="view_balance_sheet_mapping_form" model="ir.ui.view">
        <field name="name">qing.balance.sheet.mapping.form</field>
        <field name="model">qing.balance.sheet.mapping</field>
        <field name="arch" type="xml">
            <form string="Balance Sheet Mapping">
                <header>
                    <button name="action_suggest_cn" type="object" string="Suggest Native CN Accounts" invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Confirm Mapping" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_duplicate_version" type="object" string="New Revision" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">Review each account before confirming. Confirmation freezes this mapping, not the ledger. Use New Revision for changes. Trade rows 4/5/33/34 split debit and credit balances by account and partner. Rows 10-13 roll into inventory; do not map the same account twice.</div>
                    <group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft' or line_ids"/><field name="template_version"/></group>
                    <field name="line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="account_id" context="{'active_test': False}" domain="[('company_ids', 'in', parent.company_id)]" options="{'no_create': True}"/>
                            <field name="line_code"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_balance_sheet_mapping" model="ir.actions.act_window">
        <field name="name">Balance Sheet Mappings</field><field name="res_model">qing.balance.sheet.mapping</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_balance_sheet_mapping" name="Balance Sheet Mappings" parent="menu_financial_report_configuration" action="action_balance_sheet_mapping" groups="account.group_account_manager" sequence="2"/>
</odoo>
