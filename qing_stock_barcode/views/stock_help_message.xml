<odoo>
    <template id="help_message_template" inherit_id="qing_stock.help_message_template">
        <xpath expr="//p[@name='footer_help_message']" position="replace">
            <p name="footer_help_message" class="text-muted" groups="qing_stock_barcode.group_scan_user">
