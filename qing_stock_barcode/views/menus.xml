<odoo>
    <record id="action_scan_workbench" model="ir.actions.client">
        <field name="name">Warehouse Scanning</field><field name="tag">qing_stock_barcode.workbench</field>
    </record>
    <record id="menu_scan_root" model="ir.ui.menu">
        <field name="name">Warehouse Scanning</field><field name="active" eval="False"/>
    </record>
    <menuitem id="menu_scan_workbench" name="Scan" parent="stock.menu_stock_root" action="action_scan_workbench" sequence="1" groups="qing_stock_barcode.group_scan_user"/>
    <menuitem id="menu_scan_history" name="Scan History" parent="stock.menu_warehouse_report" action="action_scan_sessions" sequence="20" groups="qing_stock_barcode.group_scan_user"/>
</odoo>
