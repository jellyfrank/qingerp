<odoo>
    <record id="view_scan_session_form" model="ir.ui.view">
        <field name="name">qing.stock.scan.session.form</field>
        <field name="model">qing.stock.scan.session</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header><button name="action_open_workbench" type="object" string="Open Workbench" class="oe_highlight"/><field name="state" widget="statusbar"/></header>
                <sheet><group><field name="name"/><field name="kind"/><field name="picking_id"/><field name="inventory_location_id"/><field name="user_id"/><field name="device"/><field name="company_id"/></group>
                    <notebook>
                        <page string="Scan Lines"><field name="line_ids"><list create="false" edit="false" delete="false">
                            <field name="product_id"/><field name="location_id"/><field name="location_dest_id"/><field name="lot_id"/><field name="lot_name"/><field name="package_id"/><field name="owner_id"/><field name="quantity"/><field name="uom_id"/><field name="counted"/>
                        </list></field></page>
                        <page string="Events"><field name="event_ids"><list create="false" edit="false" delete="false">
                            <field name="create_date"/><field name="user_id"/><field name="state"/><field name="message"/><field name="request_key"/><field name="undone"/>
                        </list></field></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
