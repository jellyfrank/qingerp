<odoo>
    <record id="privilege_scan" model="res.groups.privilege">
        <field name="name">Warehouse Scanning</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record id="group_scan_user" model="res.groups">
        <field name="name">Operator</field>
        <field name="privilege_id" ref="privilege_scan"/>
        <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_scan_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_scan"/>
        <field name="implied_ids" eval="[Command.link(ref('group_scan_user'))]"/>
    </record>
    <record id="group_scan_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_scan"/>
        <field name="implied_ids" eval="[Command.link(ref('group_scan_reviewer')), Command.link(ref('stock.group_stock_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_scan_manager'))]"/>
    </record>
</odoo>
