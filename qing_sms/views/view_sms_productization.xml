<odoo>
    <record id="view_sms_application_link_form" model="ir.ui.view"><field name="name">qing.sms.application.link.form</field><field name="model">qing.sms.application.link</field><field name="arch" type="xml"><form><sheet><group><field name="application_id" readonly="1"/><field name="account_id" readonly="1"/><field name="remote_template_id" domain="[('account_id', '=', account_id)]"/></group><div class="alert alert-warning" role="alert">Check the cloud template code, content, category and variables before linking. The same name alone is insufficient.</div></sheet><footer><button name="action_link" type="object" string="Link verified template" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="view_sms_scenario_setup_form" model="ir.ui.view"><field name="name">qing.sms.scenario.setup.form</field><field name="model">qing.sms.scenario.setup</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="blueprint_id"/><field name="account_id"/><field name="sign_id" domain="[('account_id', '=', account_id)]"/><field name="remote_template_id" domain="[('account_id', '=', account_id), ('audit_state', '=', 'approved')]"/><field name="sender_user_id"/></group><div class="alert alert-info" role="status">This setup creates a reviewed binding. Enable the scenario separately after checking the sender and variables.</div></sheet><footer><button name="action_setup" type="object" string="Configure binding" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
    <record id="action_sms_scenario_setup" model="ir.actions.act_window"><field name="name">Set up domestic SMS scenario</field><field name="res_model">qing.sms.scenario.setup</field><field name="view_mode">form</field><field name="target">new</field></record>
    <record id="view_sms_scenario_test_form" model="ir.ui.view">
        <field name="name">qing.sms.scenario.test.form</field>
        <field name="model">qing.sms.scenario.test</field>
        <field name="arch" type="xml"><form><sheet>
            <group><field name="scenario_id" readonly="1"/><field name="sample_model" invisible="1"/><field name="sample_res_id"/><field name="number"/></group>
            <group string="Preview"><field name="preview_number" readonly="1"/><field name="preview_body" readonly="1"/></group>
            <div class="alert alert-warning" role="alert">A test SMS may incur a provider charge. Sending requires a separate click after preview.</div>
        </sheet><footer><button name="action_preview" type="object" string="Preview"/><button name="action_send_test" type="object" string="Send test SMS" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
    </record>
    <record id="view_sms_blueprint_list" model="ir.ui.view"><field name="name">qing.sms.blueprint.list</field><field name="model">qing.sms.blueprint</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="version"/><field name="variant_code"/><field name="category"/><field name="company_id"/></list></field></record>
    <record id="view_sms_blueprint_form" model="ir.ui.view"><field name="name">qing.sms.blueprint.form</field><field name="model">qing.sms.blueprint</field><field name="arch" type="xml"><form><header><button name="action_clone_for_company" type="object" string="Clone for company" groups="qing_sms.group_sms_manager"/><button name="action_prepare_application" type="object" string="Prepare application" groups="qing_sms.group_sms_manager"/></header><sheet><group><field name="name"/><field name="code"/><field name="version"/><field name="variant_code"/><field name="company_id"/><field name="source_blueprint_id" readonly="1"/><field name="model_id"/><field name="event_code"/><field name="category"/><field name="content"/><field name="variable_schema"/><field name="application_remark"/></group></sheet></form></field></record>
    <record id="action_sms_blueprint" model="ir.actions.act_window"><field name="name">Template blueprints</field><field name="res_model">qing.sms.blueprint</field><field name="view_mode">list,form</field></record>

    <record id="view_sms_scenario_list" model="ir.ui.view"><field name="name">qing.sms.scenario.list</field><field name="model">qing.sms.scenario</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="event_code"/><field name="enabled"/><field name="sender_user_id"/></list></field></record>
    <record id="view_sms_scenario_form" model="ir.ui.view"><field name="name">qing.sms.scenario.form</field><field name="model">qing.sms.scenario</field><field name="arch" type="xml"><form><header><button name="action_enable" type="object" string="Enable" invisible="enabled"/><button name="action_disable" type="object" string="Disable" invisible="not enabled"/><button name="action_open_test_send" type="object" string="Preview and test" groups="qing_sms.group_sms_manager"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="event_code"/><field name="model_id"/><field name="sender_user_id"/><field name="recipient_policy"/><field name="enabled" readonly="1"/><field name="enabled_from" readonly="1"/><field name="config_revision" readonly="1"/></group><field name="binding_ids" readonly="1"><list><field name="name"/><field name="variant_code"/><field name="remote_template_id"/><field name="accept_new"/></list></field></sheet></form></field></record>
    <record id="action_sms_scenario" model="ir.actions.act_window"><field name="name">Business scenarios</field><field name="res_model">qing.sms.scenario</field><field name="view_mode">list,form</field></record>

    <record id="view_sms_application_list" model="ir.ui.view"><field name="name">qing.sms.template.application.list</field><field name="model">qing.sms.template.application</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="account_id"/><field name="state"/><field name="remote_code"/><field name="provider_order_id"/></list></field></record>
    <record id="view_sms_application_form" model="ir.ui.view"><field name="name">qing.sms.template.application.form</field><field name="model">qing.sms.template.application</field><field name="arch" type="xml"><form><header><button name="action_queue" type="object" string="Submit for review" invisible="state != 'draft'"/><button name="action_clone" type="object" string="Clone draft" invisible="state == 'draft'"/><button name="action_export_materials" type="object" string="Export materials"/><button name="action_open_link" type="object" string="Link cloud template" invisible="state not in ('unknown', 'pending')"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="account_id" readonly="state != 'draft'"/><field name="sign_id" readonly="state != 'draft'"/><field name="blueprint_id" readonly="state != 'draft'"/><field name="category" readonly="state != 'draft'"/><field name="content" readonly="state != 'draft'"/><field name="variable_schema" readonly="state != 'draft'"/><field name="provider_variable_rules" readonly="state != 'draft'"/><field name="application_remark" readonly="state != 'draft'"/><field name="apply_scene_content" readonly="state != 'draft'"/></group><group><field name="remote_code"/><field name="provider_request_id"/><field name="provider_order_id"/><field name="error_code"/><field name="reject_reason"/><field name="last_checked_at"/></group></sheet></form></field></record>
    <record id="action_sms_application" model="ir.actions.act_window"><field name="name">Template applications</field><field name="res_model">qing.sms.template.application</field><field name="view_mode">list,form</field></record>

    <record id="view_sms_event_list" model="ir.ui.view"><field name="name">qing.sms.event.list</field><field name="model">qing.sms.event</field><field name="arch" type="xml"><list create="0"><field name="event_key"/><field name="company_id"/><field name="event_code"/><field name="state"/><field name="reason_code"/></list></field></record>
    <record id="view_sms_event_form" model="ir.ui.view"><field name="name">qing.sms.event.form</field><field name="model">qing.sms.event</field><field name="arch" type="xml"><form create="0" edit="0"><header><button name="action_recheck" type="object" string="Recheck" invisible="state != 'blocked'" groups="qing_sms.group_sms_manager"/></header><sheet><group><field name="event_key"/><field name="event_code"/><field name="company_id"/><field name="state"/><field name="reason_code"/><field name="reason_message"/><field name="sender_user_id"/><field name="binding_id"/><field name="occurred_at"/></group><field name="message_ids"><list><field name="event_key"/><field name="state"/><field name="number"/></list></field></sheet></form></field></record>
    <record id="action_sms_event" model="ir.actions.act_window"><field name="name">Business events</field><field name="res_model">qing.sms.event</field><field name="view_mode">list,form</field></record>
</odoo>
