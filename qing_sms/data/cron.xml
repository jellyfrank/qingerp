<odoo noupdate="1">
    <record id="ir_cron_dispatch" model="ir.cron">
        <field name="name">国内短信：发送与回执查询</field><field name="model_id" ref="model_qing_sms_message"/>
        <field name="state">code</field><field name="code">model._cron_dispatch()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_sync" model="ir.cron">
        <field name="name">国内短信：同步签名与模板</field><field name="model_id" ref="model_qing_sms_account"/>
        <field name="state">code</field><field name="code">model._cron_sync()</field>
        <field name="interval_number">1</field><field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_prepare_events" model="ir.cron">
        <field name="name">Domestic SMS: prepare business events</field><field name="model_id" ref="model_qing_sms_event"/>
        <field name="state">code</field><field name="code">model._cron_prepare()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_template_application" model="ir.cron">
        <field name="name">Domestic SMS: template applications</field><field name="model_id" ref="model_qing_sms_template_application"/>
        <field name="state">code</field><field name="code">model._cron_process()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field>
    </record>
</odoo>
