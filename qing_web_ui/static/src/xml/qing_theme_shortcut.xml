<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="qing_web_ui.ThemeShortcut">
        <Dropdown menuClass="'o_qing_theme_shortcut_menu'" disabled="this.state.saving">
            <button type="button" class="o_qing_theme_shortcut o-dropdown--narrow"
                    t-att-title="this.label" t-att-aria-label="this.label"
                    t-att-aria-busy="this.state.saving ? 'true' : 'false'"
                    t-att-aria-disabled="this.state.saving ? 'true' : 'false'">
                <t t-set="mode" t-value="this.state.mode"/>
                <t t-call="qing_web_ui.ThemeShortcutIcon"/>
            </button>
            <t t-set-slot="content">
                <div class="o_qing_theme_choices">
                    <t t-foreach="this.options" t-as="option" t-key="option.value">
                        <DropdownItem tag="'button'"
                            class="'o_qing_theme_choice ' + (this.state.mode === option.value ? 'is-active' : '')"
                            attrs="{ type: 'button', title: option.label, 'aria-label': option.label,
                                role: 'menuitemradio', 'aria-checked': this.state.mode === option.value ? 'true' : 'false',
                                'data-theme-mode': option.value }"
                            onSelected="() => this.selectMode(option.value)">
                            <t t-set="mode" t-value="option.value"/>
                            <t t-call="qing_web_ui.ThemeShortcutIcon"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
    <t t-name="qing_web_ui.ThemeShortcutIcon">
        <svg class="o_qing_theme_shortcut_icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
             t-att-data-theme-icon="mode" aria-hidden="true" focusable="false">
            <t t-if="mode === 'light'">
                <circle cx="12" cy="12" r="3.75"/>
                <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/>
            </t>
            <path t-elif="mode === 'dark'" d="M20.7 13.3A8.8 8.8 0 0 1 10.7 3.3 8.8 8.8 0 1 0 20.7 13.3Z"/>
            <t t-else="">
                <rect x="3" y="4" width="18" height="13" rx="2.5"/>
                <path d="M12 17v4M8 21h8"/>
            </t>
        </svg>
    </t>
</templates>
